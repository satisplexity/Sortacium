<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Sortacium.Presentation.App"
    RequestedThemeVariant="Default">

    <Application.Styles>

        <FluentTheme/>

        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

        <StyleInclude
            Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <StyleInclude
            Source="avares://Sortacium.Presentation/Themes/SortingCodeEditor.axaml"/>

    </Application.Styles>

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Palettes/Dark.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Common/Brushes.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Common/Dimensions.axaml"/>

                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Controls/BeveledBorder.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Controls/Border.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Controls/Window.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/Fonts.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/Icons.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/Colors.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/Brushes.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/BorderThemes.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/ToolTip.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/VerticalSlider.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/HorizontalSlider.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/IconButton.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/StyledComboBox.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/StyledScrollBar.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/StyledListBox.axaml"/>

                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Settings.axaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>
