<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Sortacium.Presentation.App"
    RequestedThemeVariant="Dark">

    <Application.Styles>

        <FluentTheme/>

        <StyleInclude
            Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <StyleInclude
            Source="avares://Sortacium.Presentation/Themes/Control/SortingCodeEditor.axaml"/>

    </Application.Styles>

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="/Themes/Palettes/Dark.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="/Themes/Palettes/Light.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Common/Dimensions.axaml"/>

                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Control/BeveledBorder.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Control/Border.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Control/Window.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/Fonts.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Resources/Icons.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/ToolTip.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/VerticalSlider.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/HorizontalSlider.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/IconButton.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/StyledComboBox.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/StyledScrollBar.axaml"/>

                <ResourceInclude
                    Source="avares://Sortacium.Presentation/Themes/Control/StyledListBox.axaml"/>

                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Control/Settings.axaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>
