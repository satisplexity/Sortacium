<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sortacium.Presentation.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Sortacium.Presentation/Resources/Icons.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Resources/Colors.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Resources/Brushes.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Resources/HorizontalSlider.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/Window.axaml"/>
                <ResourceInclude Source="avares://Sortacium.Presentation/Themes/IconButton.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
