<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="using:Sortacium.Presentation.Components">
    <ControlTheme x:Key="Settings.ThemeCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource Palette.Brush.242424}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.Border}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}" components:StrokeGradientAdapter.Enable="True">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.AccentBorder}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource Palette.Brush.382746}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.AccentBorder}"/>
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Settings.Switch" TargetType="ToggleSwitch">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource Palette.Brush.151515}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="2" CornerRadius="15" Padding="3" components:StrokeGradientAdapter.Enable="True">
                    <Canvas Name="PART_SwitchKnob" Width="22" Height="20" HorizontalAlignment="Left">
                        <Panel Name="PART_MovingKnobs" Width="20" Height="20">
                            <Border CornerRadius="10" Background="{DynamicResource Palette.Brush.EEEEEE}"/>
                        </Panel>
                    </Canvas>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource Palette.Brush.853CAE}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.AccentBorder}"/>
        </Style>
        <Style Selector="^:focus-visible, ^:pointerover"><Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.AccentBorder}"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="Settings.ColorButton" TargetType="DropDownButton">
        <Setter Property="Background" Value="{DynamicResource Palette.Brush.242424}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="2" CornerRadius="12" Padding="6" components:StrokeGradientAdapter.Enable="True">
                    <Grid ColumnDefinitions="*,24">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
                        <PathIcon Grid.Column="1" Width="10" Height="6" Foreground="{DynamicResource Palette.Brush.CCCCEE}"
                                  Data="M0,0 L5,5 L10,0 L8,0 L5,3 L2,0 Z"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource ScrollSurface.AccentBorder}"/></Style>
    </ControlTheme>
</ResourceDictionary>
