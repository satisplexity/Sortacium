<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components">

    <ControlTheme
        x:Key="{x:Type controls:IconButton}"
        TargetType="{x:Type controls:IconButton}">

        <Setter
            Property="Width"
            Value="40"/>

        <Setter
            Property="Height"
            Value="40"/>

        <Setter
            Property="CornerRadius"
            Value="12"/>

        <Setter
            Property="BorderThickness"
            Value="2"/>

        <Setter
            Property="RenderTransform"
            Value="translateY(0px)"/>

        <Setter
            Property="Padding"
            Value="12"/>

        <Setter
            Property="Cursor"
            Value="Hand"/>

        <!-- Transitions -->
        <Setter
            Property="Transitions">

            <Transitions>

                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15"
                    Easing="CubicEaseOut"/>

                <ThicknessTransition
                    Property="Padding"
                    Duration="0:0:0.2"
                    Easing="SineEaseOut"/>

            </Transitions>

        </Setter>

        <Setter
            Property="Background"
            Value="#242424"/>

        <Setter
            Property="Foreground"
            Value="#CCCCEE"/>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                    StartPoint="50%,0%"
                    EndPoint="50%,100%">

                    <GradientStop
                        Offset="0"
                        Color="#353535"/>

                    <GradientStop
                        Offset="0.2"
                        Color="#242424"/>

                    <GradientStop
                        Offset="0.8"
                        Color="#242424"/>

                    <GradientStop
                        Offset="1"
                        Color="#131313"/>

                </LinearGradientBrush>

            </Setter.Value>

        </Setter>

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    components:StrokeGradientAdapter.Enable="True">

                    <Path
                        Data="{TemplateBinding Icon}"
                        Fill="{TemplateBinding Foreground}"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"/>

                </Border>

            </ControlTemplate>

        </Setter>

        <Style
            Selector="^:pointerover">

            <Setter
                Property="Background"
                Value="#242424"/>

            <Setter
                Property="Foreground"
                Value="#AF4BE9"/>

            <Setter
                Property="Padding"
                Value="11"/>

        </Style>

        <Style
            Selector="^:pressed">

            <Setter
                Property="Padding"
                Value="11"/>

            <Setter
                Property="Background"
                Value="#212121"/>

            <Setter
                Property="Foreground"
                Value="#AF4BE9"/>

            <Setter
                Property="RenderTransform"
                Value="translateY(-1px)"/>

            <Setter
                Property="BorderBrush">

                <Setter.Value>

                    <LinearGradientBrush
                        StartPoint="50%,0%"
                        EndPoint="50%,100%">

                        <GradientStop
                            Offset="0"
                            Color="#131313"/>

                        <GradientStop
                            Offset="0.2"
                            Color="#212121"/>

                        <GradientStop
                            Offset="0.8"
                            Color="#212121"/>

                        <GradientStop
                            Offset="1"
                            Color="#353535"/>

                    </LinearGradientBrush>

                </Setter.Value>

            </Setter>

        </Style>

    </ControlTheme>

</ResourceDictionary>
