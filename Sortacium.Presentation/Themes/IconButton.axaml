<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:Sortacium.Presentation.Services"
    xmlns:controls="clr-namespace:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components">

    <ControlTheme
        x:Key="{x:Type controls:IconButton}"
        TargetType="{x:Type controls:IconButton}">

        <Setter
            Property="Width"
            Value="{Binding Height, RelativeSource={RelativeSource Self}}"/>

        <Setter
            Property="Height"
            Value="40"/>

        <Setter
            Property="CornerRadius"
            Value="12"/>

        <Setter
            Property="BorderThickness"
            Value="2"/>

        <Setter
            Property="RenderTransform"
            Value="translateY(0px)"/>

        <Setter
            Property="Padding"
            Value="12"/>

        <Setter
            Property="Cursor"
            Value="Hand"/>

        <!-- Transitions -->
        <Setter
            Property="Transitions">

            <Transitions>

                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15"
                    Easing="CubicEaseOut"/>

                <ThicknessTransition
                    Property="Padding"
                    Duration="0:0:0.2"
                    Easing="SineEaseOut"/>

            </Transitions>

        </Setter>

        <Setter
            Property="Background"
            Value="{DynamicResource Palette.Brush.242424}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource Palette.Brush.CCCCEE}"/>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                    StartPoint="50%,0%"
                    EndPoint="50%,100%">

                    <GradientStop
                        Offset="0"
                        Color="{Binding Colors[353535], Source={x:Static appearance:AppearanceService.Instance}}"/>

                    <GradientStop
                        Offset="0.2"
                        Color="{Binding Colors[242424], Source={x:Static appearance:AppearanceService.Instance}}"/>

                    <GradientStop
                        Offset="0.8"
                        Color="{Binding Colors[242424], Source={x:Static appearance:AppearanceService.Instance}}"/>

                    <GradientStop
                        Offset="1"
                        Color="{Binding Colors[131313], Source={x:Static appearance:AppearanceService.Instance}}"/>

                </LinearGradientBrush>

            </Setter.Value>

        </Setter>

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    components:StrokeGradientAdapter.Enable="True">

                    <Grid
                        ColumnDefinitions="Auto,Auto"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">

                        <Path
                            Width="12"
                            Height="12"
                            Data="{TemplateBinding Icon}"
                            Fill="{TemplateBinding Foreground}"
                            Stretch="Uniform"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Name="PART_Text"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </ControlTemplate>

        </Setter>

        <Style Selector="^:has-text">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style Selector="^:not(:has-text) /template/ TextBlock#PART_Text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style
            Selector="^:pointerover">

            <Setter
                Property="Background"
                Value="{DynamicResource Palette.Brush.242424}"/>

            <Setter
                Property="Foreground"
                Value="{DynamicResource Palette.Brush.AF4BE9}"/>

            <Setter
                Property="Padding"
                Value="11"/>

        </Style>

        <Style
            Selector="^:pressed">

            <Setter
                Property="Padding"
                Value="11"/>

            <Setter
                Property="Background"
                Value="{DynamicResource Palette.Brush.212121}"/>

            <Setter
                Property="Foreground"
                Value="{DynamicResource Palette.Brush.AF4BE9}"/>

            <Setter
                Property="RenderTransform"
                Value="translateY(-1px)"/>

            <Setter
                Property="BorderBrush">

                <Setter.Value>

                    <LinearGradientBrush
                        StartPoint="50%,0%"
                        EndPoint="50%,100%">

                        <GradientStop
                            Offset="0"
                            Color="{Binding Colors[131313], Source={x:Static appearance:AppearanceService.Instance}}"/>

                        <GradientStop
                            Offset="0.2"
                            Color="{Binding Colors[212121], Source={x:Static appearance:AppearanceService.Instance}}"/>

                        <GradientStop
                            Offset="0.8"
                            Color="{Binding Colors[212121], Source={x:Static appearance:AppearanceService.Instance}}"/>

                        <GradientStop
                            Offset="1"
                            Color="{Binding Colors[353535], Source={x:Static appearance:AppearanceService.Instance}}"/>

                    </LinearGradientBrush>

                </Setter.Value>

            </Setter>

        </Style>

        <Style Selector="^:has-text:pointerover, ^:has-text:pressed">
            <Setter Property="Padding" Value="11,6"/>
        </Style>

    </ControlTheme>

</ResourceDictionary>
