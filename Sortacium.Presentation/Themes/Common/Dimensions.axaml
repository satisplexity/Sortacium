<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CornerRadius.Window">15</CornerRadius>
    <CornerRadius x:Key="CornerRadius.WindowTitleBar">15, 15, 0, 0</CornerRadius>

    <Thickness x:Key="Thickness.Border.Generic">2, 3</Thickness>
    <Thickness x:Key="Thickness.Border.WindowTitleBar">0, 0, 0, 3</Thickness>

    <Thickness x:Key="Thickness.Panel.Padding">10</Thickness>

    <x:Double x:Key="Double.ResizeBorder.Side">6</x:Double>
    <x:Double x:Key="Double.ResizeBorder.Corner">10</x:Double>

</ResourceDictionary>
