<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window.Surface"
                     Color="{DynamicResource Color.Window.Surface}"/>

    <LinearGradientBrush x:Key="Brush.Window.Border"
                         StartPoint="50%, 0%"
                         EndPoint="50%, 100%">

        <GradientStop Color="{DynamicResource Color.Window.Highlight}"
                      Offset="0"/>

        <GradientStop Color="{DynamicResource Color.Window.Surface}"
                      Offset="0.1"/>

        <GradientStop Color="{DynamicResource Color.Window.Surface}"
                      Offset="0.9"/>

        <GradientStop Color="{DynamicResource Color.Window.Shadow}"
                      Offset="1"/>

    </LinearGradientBrush>

</ResourceDictionary>
