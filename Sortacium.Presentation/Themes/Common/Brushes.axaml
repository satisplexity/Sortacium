<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window.Surface"
                     Color="{DynamicResource Color.Window.Surface}"/>

    <SolidColorBrush x:Key="Brush.Panel.Surface"
                     Color="{DynamicResource Color.Panel.Surface}"/>

    <SolidColorBrush x:Key="Brush.RecessedPanel.Surface"
                     Color="{DynamicResource Color.RecessedPanel.Surface}"/>

    <SolidColorBrush x:Key="Brush.Panel.Shadow"
                     Color="{DynamicResource Color.Panel.Shadow}"/>

</ResourceDictionary>
