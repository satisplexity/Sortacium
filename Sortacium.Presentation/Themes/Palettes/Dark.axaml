<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window.Surface">#FF191919</Color>
    <Color x:Key="Color.Window.Highlight">#FF353535</Color>
    <Color x:Key="Color.Window.Shadow">#FF141414</Color>

    <Color x:Key="Color.Panel.Surface">#FF242424</Color>
    <Color x:Key="Color.Panel.HightLight">#FFF</Color>
    <Color x:Key="Color.Panel.Shadow">#FF151515</Color>

    <Color x:Key="Color.RecessedPanel.Surface">#AAA</Color>
    <Color x:Key="Color.RecessedPanel.Highlight">#AAA</Color>
    <Color x:Key="Color.RecessedPanel.Shadow">#AAA</Color>

</ResourceDictionary>
