            <Color x:Key="Color.Accent.Surface.Selected">#FF503229</Color>

            <Color x:Key="Color.Accent.Surface.Pressed">#FF603B24</Color>

            <Color x:Key="Color.Accent.Surface.SelectedHover">#FF764326</Color>

            <Color x:Key="Color.Accent.Control.Pressed">#FFAB5A33</Color>

            <Color x:Key="Color.Accent.Primary">#FFF69060</Color>

            <Color x:Key="Color.Accent.Stroke.Fill">#FFCB7349</Color>

            <Color x:Key="Color.Accent.Stroke.Shadow">#FF904C2C</Color>

            <Color x:Key="Color.Accent.Control">#FFC76A3C</Color>

            <Color x:Key="Color.Accent.Slider.Fill">#FFBF5A2B</Color>

            <Color x:Key="Color.Accent.Slider.ThumbStroke">#FFCB6839</Color>

