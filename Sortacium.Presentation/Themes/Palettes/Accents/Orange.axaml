            <Color x:Key="SystemAccentColor">#FFF69060</Color>

            <Color x:Key="SystemAccentColorLight1">#FFF79E75</Color>

            <Color x:Key="SystemAccentColorLight2">#FFF8AC88</Color>

            <Color x:Key="SystemAccentColorLight3">#FFF9BA9C</Color>

