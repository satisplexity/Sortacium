    <Color x:Key="Color.Accent.Preview.Dark">#FFF69060</Color>

    <Color x:Key="Color.Accent.Preview.Light">#FFA04620</Color>

    <SolidColorBrush
        x:Key="Brush.Accent.Preview.Dark"
