            <Color x:Key="Color.Accent.Control.Hover">#FFBC4E7C</Color>
            <Color x:Key="Color.Accent.Highlight.Transparent">#00F7DDE8</Color>
            <Color x:Key="Color.Accent.Primary.Transparent">#00A02F5F</Color>
