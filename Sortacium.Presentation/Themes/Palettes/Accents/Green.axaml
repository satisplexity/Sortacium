            <Color x:Key="Color.Accent.Control.Hover">#FF579842</Color>
            <Color x:Key="Color.Accent.Highlight.Transparent">#00DFF3D8</Color>
            <Color x:Key="Color.Accent.Primary.Transparent">#00386D26</Color>
