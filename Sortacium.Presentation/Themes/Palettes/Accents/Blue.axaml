            <Color x:Key="Color.Accent.Text.Hover">#FF174D94</Color>
            <Color x:Key="Color.Accent.Surface.Focused">#FFE8F2FC</Color>
            <Color x:Key="Color.Accent.Text.Selected">#FF10468A</Color>
            <Color x:Key="Color.Accent.Control.Hover">#FF3177CF</Color>
            <Color x:Key="Color.Accent.Highlight.Transparent">#00D7E7FB</Color>
            <Color x:Key="Color.Accent.Primary.Transparent">#00185AAA</Color>
