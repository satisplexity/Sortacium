    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="Color.Accent.Preview.Dark">#FFF5BD55</Color>
    <Color x:Key="Color.Accent.Preview.Light">#FF875200</Color>
    <SolidColorBrush x:Key="Brush.Accent.Preview.Dark" Color="{StaticResource Color.Accent.Preview.Dark}"/>
    <SolidColorBrush x:Key="Brush.Accent.Preview.Light" Color="{StaticResource Color.Accent.Preview.Light}"/>
</ResourceDictionary>
