            <Color x:Key="Color.Accent.Text.Hover">#FF754B02</Color>
            <Color x:Key="Color.Accent.Surface.Focused">#FFFFF2E1</Color>
            <Color x:Key="Color.Accent.Text.Selected">#FF6B4200</Color>
            <Color x:Key="Color.Accent.Control.Hover">#FFBE7C12</Color>
            <Color x:Key="Color.Accent.Highlight.Transparent">#00FFEBCB</Color>
            <Color x:Key="Color.Accent.Primary.Transparent">#00875200</Color>
            <Color x:Key="Color.Accent.Highlight">#FFFFEBCB</Color>
