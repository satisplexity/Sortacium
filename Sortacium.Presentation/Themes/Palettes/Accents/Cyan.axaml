            <Color x:Key="Color.Accent.Highlight">#FF1F424B</Color>

            <Color x:Key="SystemAccentColor">#FF45C9E7</Color>

            <Color x:Key="SystemAccentColorLight1">#FF5DD0EA</Color>

            <Color x:Key="SystemAccentColorLight2">#FF74D7ED</Color>

