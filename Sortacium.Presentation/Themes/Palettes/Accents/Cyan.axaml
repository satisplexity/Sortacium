            <Color x:Key="Color.Accent.Surface.Hover">#FF253536</Color>

            <Color x:Key="Color.Accent.Surface.Selected">#FF264144</Color>

            <Color x:Key="Color.Accent.Surface.Pressed">#FF234551</Color>

            <Color x:Key="Color.Accent.Surface.SelectedHover">#FF265663</Color>

            <Color x:Key="Color.Accent.Control.Pressed">#FF347D8F</Color>

            <Color x:Key="Color.Accent.Primary">#FF45C9E7</Color>

            <Color x:Key="Color.Accent.Stroke.Fill">#FF3F9DB3</Color>

            <Color x:Key="Color.Accent.Stroke.Shadow">#FF2C6A78</Color>

            <Color x:Key="Color.Accent.Control">#FF3B94A9</Color>

            <Color x:Key="Color.Accent.Slider.Fill">#FF2F8A9F</Color>

            <Color x:Key="Color.Accent.Slider.ThumbStroke">#FF3896AC</Color>

