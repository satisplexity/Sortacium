    <Color x:Key="Color.Accent.Preview.Dark">#FF45C9E7</Color>

    <Color x:Key="Color.Accent.Preview.Light">#FF006B82</Color>

    <SolidColorBrush
        x:Key="Brush.Accent.Preview.Dark"
        Color="{StaticResource Color.Accent.Preview.Dark}"/>

    <SolidColorBrush
        x:Key="Brush.Accent.Preview.Light"
        Color="{StaticResource Color.Accent.Preview.Light}"/>

