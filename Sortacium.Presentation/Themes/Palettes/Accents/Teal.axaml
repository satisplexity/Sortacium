            <Color x:Key="Color.Accent.Text.Hover">#FF096356</Color>
            <Color x:Key="Color.Accent.Surface.Focused">#FFE1FEF8</Color>
            <Color x:Key="Color.Accent.Text.Selected">#FF045C4E</Color>
            <Color x:Key="Color.Accent.Control.Hover">#FF1CAA93</Color>
            <Color x:Key="Color.Accent.Highlight.Transparent">#00CAFEF5</Color>
            <Color x:Key="Color.Accent.Primary.Transparent">#00087260</Color>
            <Color x:Key="Color.Accent.Highlight">#FFCAFEF5</Color>
