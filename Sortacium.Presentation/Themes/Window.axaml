<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:Sortacium.Presentation.Services"
    xmlns:components="using:Sortacium.Presentation.Components"
    xmlns:controls="using:Sortacium.Presentation.Controls">

    <ControlTheme
        x:Key="{x:Type Window}"
        TargetType="{x:Type Window}">

        <Setter
            Property="Title"
            Value="Sortacium"/>

        <Setter
            Property="Icon"
            Value="/Assets/avalonia-logo.ico"/>

        <Setter
            Property="Width"
            Value="1200"/>

        <Setter
            Property="Height"
            Value="1000"/>

        <Setter
            Property="MinWidth"
            Value="1200"/>

        <Setter
            Property="MinHeight"
            Value="800"/>

        <Setter
            Property="Background"
            Value="Transparent"/>

        <Setter
            Property="CanResize"
            Value="True"/>

        <Setter
            Property="WindowStartupLocation"
            Value="CenterScreen"/>

        <Setter
            Property="WindowDecorations"
            Value="None"/>

        <Setter
            Property="ExtendClientAreaToDecorationsHint"
            Value="True"/>

        <Setter
            Property="FontFamily"
            Value="{StaticResource Comfortaa}"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <controls:BeveledBorder Theme="{StaticResource BeveledBorder.Window}">

                    <Grid>

                        <ContentControl
                            Content="{TemplateBinding Content}"/>

                        <Border
                            Width="6"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Cursor="SizeWestEast"
                            WindowDecorationProperties.ElementRole="ResizeW"/>

                        <Border
                            Width="6"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Cursor="SizeWestEast"
                            WindowDecorationProperties.ElementRole="ResizeE"/>

                        <Border
                            Height="6"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Cursor="SizeNorthSouth"
                            WindowDecorationProperties.ElementRole="ResizeN"/>

                        <Border
                            Height="6"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Cursor="SizeNorthSouth"
                            WindowDecorationProperties.ElementRole="ResizeS"/>

                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Cursor="TopLeftCorner"
                            WindowDecorationProperties.ElementRole="ResizeNW"/>

                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Cursor="TopRightCorner"
                            WindowDecorationProperties.ElementRole="ResizeNE"/>

                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Cursor="BottomLeftCorner"
                            WindowDecorationProperties.ElementRole="ResizeSW"/>

                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Cursor="BottomRightCorner"
                            WindowDecorationProperties.ElementRole="ResizeSE"/>

                    </Grid>

                </controls:BeveledBorder>

            </ControlTemplate>

        </Setter>

    </ControlTheme>

</ResourceDictionary>
