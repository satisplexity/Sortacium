<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components">

    <ControlTheme
        x:Key="VerticalSlider.SegmentTheme"
        TargetType="RepeatButton">

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="{TemplateBinding Background}"/>

            </ControlTemplate>

        </Setter>

    </ControlTheme>

    <!-- Thumb -->
    <ControlTheme
        x:Key="VerticalSlider.ThumbTheme"
        TargetType="Thumb">

        <Setter
            Property="Transitions">

            <Transitions>

                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15"
                    Easing="CubicEaseOut"/>

            </Transitions>

        </Setter>

        <Setter Property="BorderBrush" Value="{DynamicResource Slider.Vertical.Thumb.Border}"/>

        <Setter
            Property="RenderTransform"
            Value="translateY(0px)"/>

        <Setter
            Property="Background"
            Value="{DynamicResource Brush.Accent.Control}"/>

        <Setter
            Property="Height"
            Value="36"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <!-- Outer Border -->
                <Border
                    Background="{DynamicResource Brush.Accent.Slider.Fill}"
                    BorderThickness="0,2,0,0"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource Brush.Accent.Slider.ThumbStroke}">

                    <!-- Inner Border -->
                    <Border
                        Name="PART_InnerBorder"
                        Background="{DynamicResource Brush.Accent.Control}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Margin="6"
                        RenderTransform="translateY(0px)"
                        components:StrokeGradientAdapter.Source="{DynamicResource Slider.Vertical.Thumb.InnerBorder}">

                        <Border.Transitions>

                            <Transitions>

                                <BrushTransition
                                    Property="Background"
                                    Duration="0:0:0.2"
                                    Easing="CubicEaseOut"/>

                                <BrushTransition
                                    Property="BorderBrush"
                                    Duration="0:0:0.2"
                                    Easing="CubicEaseOut"/>

                                <TransformOperationsTransition
                                    Property="RenderTransform"
                                    Duration="0:0:0.15"
                                    Easing="CubicEaseOut"/>

                            </Transitions>

                        </Border.Transitions>

                    </Border>

                </Border>

            </ControlTemplate>

        </Setter>

        <Style
            Selector="^:pointerover">

            <Setter
                Property="Cursor"
                Value="Hand"/>

        </Style>

        <Style
            Selector="^:pressed /template/ Border#PART_InnerBorder">

            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Accent.Slider.ThumbPressed}"/>

            <Setter
                Property="RenderTransform"
                Value="translateY(-1px)"/>

            <Setter Property="components:StrokeGradientAdapter.Source" Value="{DynamicResource Slider.Vertical.Thumb.PressedBorder}"/>

        </Style>

    </ControlTheme>

    <ControlTheme
        x:Key="{x:Type controls:VerticalSlider}"
        TargetType="{x:Type controls:VerticalSlider}">

        <Setter
            Property="Orientation"
            Value="Vertical"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource Brush.Text.Strong}"/>

        <Setter
            Property="FontWeight"
            Value="Medium"/>

        <Setter
            Property="FontSize"
            Value="14"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="{DynamicResource Brush.Slider.Vertical.Background}"
                    CornerRadius="18"
                    BorderThickness="1.5"
                    Padding="6, 6, 6, 8"
                    components:StrokeGradientAdapter.Source="{DynamicResource Slider.Vertical.Frame.Border}">

                    <Border
                        Background="{DynamicResource Brush.Slider.Vertical.Track}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        components:StrokeGradientAdapter.Source="{DynamicResource Slider.Vertical.Track.Border}">

                        <Grid
                            RowDefinitions="Auto, *, Auto">

                            <Border
                                x:Name="PART_TitleBackgroundBorder"
                                CornerRadius="13,13,0,0"
                                Background="{DynamicResource Brush.Slider.Vertical.EndCap}"
                                BorderBrush="{DynamicResource Brush.Slider.Vertical.EndCapStroke}"
                                BorderThickness="0,0,0,2">

                                <TextBlock
                                    Text="{TemplateBinding Title}"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Margin="0, 8, 0, 8"
                                    TextWrapping="Wrap"/>

                            </Border>

                            <Track
                                Name="PART_Track"
                                Grid.Row="1"
                                Orientation="Vertical"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value, Mode=TwoWay}"
                                IsDirectionReversed="False">

                                <Track.DecreaseButton>

                                    <RepeatButton
                                        Name="PART_DecreaseButton"
                                        Theme="{StaticResource VerticalSlider.SegmentTheme}"
                                        Focusable="False"
                                        Background="{DynamicResource Slider.Vertical.Track.Fill}">

                                    </RepeatButton>

                                </Track.DecreaseButton>

                                <Track.IncreaseButton>

                                    <RepeatButton
                                        Name="PART_IncreaseButton"
                                        Theme="{StaticResource VerticalSlider.SegmentTheme}"
                                        Background="{DynamicResource Brush.Slider.Vertical.Unfilled}"
                                        Focusable="False"/>

                                </Track.IncreaseButton>

                                <Track.Thumb>

                                    <Thumb
                                        Name="PART_Thumb"
                                        Theme="{StaticResource VerticalSlider.ThumbTheme}"/>

                                </Track.Thumb>

                            </Track>

                            <Border
                                x:Name="PART_ValueBackgroundBorder"
                                Grid.Row="2"
                                CornerRadius="0,0,13,13"
                                BorderThickness="0, 2, 0, 0"
                                BorderBrush="{DynamicResource Brush.Stroke.RecessedHighlight}"
                                Background="{DynamicResource Brush.Slider.Vertical.EndCap}">

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0, 10, 0, 8">

                                    <TextBlock
                                        Text="{Binding Value,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           StringFormat='{}{0:F0}'}"
                                        HorizontalAlignment="Center"/>

                                    <TextBlock
                                        Text="{TemplateBinding Suffix}"
                                        HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>

                </Border>

            </ControlTemplate>

        </Setter>

    </ControlTheme>

</ResourceDictionary>
