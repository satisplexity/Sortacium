<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sortacium.Presentation.Controls">

    <ControlTheme
        x:Key="{x:Type controls:IconButton}"
        TargetType="{x:Type controls:IconButton}">

        <Setter
            Property="Width"
            Value="{Binding Height, RelativeSource={RelativeSource Self}}"/>

        <Setter
            Property="Height"
            Value="40"/>

        <Setter
            Property="CornerRadius"
            Value="12"/>

        <Setter
            Property="BorderThickness"
            Value="1, 2"/>

        <Setter
            Property="RenderTransform"
            Value="translateY(0px)"/>

        <Setter
            Property="Padding"
            Value="12"/>

        <Setter
            Property="Cursor"
            Value="Hand"/>

        <!-- Transitions -->
        <Setter
            Property="Transitions">

            <Transitions>

                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.1"
                    Easing="SineEaseOut"/>

                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15"
                    Easing="CubicEaseOut"/>

                <ThicknessTransition
                    Property="Padding"
                    Duration="0:0:0.2"
                    Easing="SineEaseOut"/>

            </Transitions>

        </Setter>

        <Setter
            Property="Background"
            Value="{DynamicResource Brush.Button.Background.Default}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource Brush.Button.Foreground.Default}"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <controls:BeveledBorder
                    Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">

                    <Grid
                        ColumnDefinitions="Auto,Auto"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">

                        <Path
                            Width="12"
                            Height="12"
                            Data="{TemplateBinding Icon}"
                            Fill="{TemplateBinding Foreground}"
                            Stretch="Uniform"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Name="PART_Text"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </controls:BeveledBorder>

            </ControlTemplate>

        </Setter>

        <Style
            Selector="^:has-text">

            <Setter
                Property="Width"
                Value="NaN"/>

            <Setter
                Property="Height"
                Value="NaN"/>

            <Setter
                Property="MinHeight"
                Value="40"/>

            <Setter
                Property="Padding"
                Value="12,6"/>

        </Style>

        <Style
            Selector="^:not(:has-text) /template/ TextBlock#PART_Text">

            <Setter
                Property="IsVisible"
                Value="False"/>

        </Style>

        <Style
            Selector="^:pointerover">

            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Button.Background.PointerOver}"/>

            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Button.Foreground.PointerOver}"/>

            <Setter
                Property="Padding"
                Value="11"/>

        </Style>

        <Style
            Selector="^:pressed">

            <Setter
                Property="Padding"
                Value="11"/>

            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Button.Background.Pressed}"/>

            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Button.Foreground.Pressed}"/>

            <Setter
                Property="RenderTransform"
                Value="translateY(0px)"/>

        </Style>

        <Style
            Selector="^:disabled">

            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Button.Background.Disabled}"/>

            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Button.Foreground.Disabled}"/>

        </Style>

        <Style
            Selector="^ /template/ controls|BeveledBorder#PART_Border">

            <Setter
                Property="StrokeHighlightColor"
                Value="{DynamicResource Color.Button.Stroke.Highlight.Default}"/>

            <Setter
                Property="StrokeShadowColor"
                Value="{DynamicResource Color.Button.Stroke.Shadow.Default}"/>

            <Setter
                Property="Transitions">

                <Transitions>

                    <ColorTransition
                        Property="StrokeHighlightColor"
                        Duration="0:0:0.2"
                        Easing="SineEaseOut"/>

                    <ColorTransition
                        Property="StrokeShadowColor"
                        Duration="0:0:0.2"
                        Easing="SineEaseOut"/>

                </Transitions>

            </Setter>

        </Style>

        <Style
            Selector="^:pressed /template/ controls|BeveledBorder#PART_Border">

            <Setter
                Property="StrokeHighlightColor"
                Value="{DynamicResource Color.Button.Stroke.Highlight.Pressed}"/>

            <Setter
                Property="StrokeShadowColor"
                Value="{DynamicResource Color.Button.Stroke.Shadow.Pressed}"/>

        </Style>

        <Style
            Selector="^:disabled /template/ controls|BeveledBorder#PART_Border">

            <Setter
                Property="StrokeHighlightColor"
                Value="{DynamicResource Color.Button.Stroke.Highlight.Disabled}"/>

            <Setter
                Property="StrokeShadowColor"
                Value="{DynamicResource Color.Button.Stroke.Shadow.Disabled}"/>

        </Style>

        <Style
            Selector="^:has-text:pointerover, ^:has-text:pressed">

            <Setter
                Property="Padding"
                Value="11,6"/>

        </Style>

    </ControlTheme>

</ResourceDictionary>
