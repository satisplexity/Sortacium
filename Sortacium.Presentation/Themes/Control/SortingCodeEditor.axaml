<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:AvaloniaEdit">
    <Style Selector="editor|TextEditor.sorting-code-editor /template/ ScrollViewer /template/ ScrollBar, ListBox.algorithm-list /template/ ScrollViewer /template/ ScrollBar">
        <Setter Property="Theme" Value="{DynamicResource StyledScrollBar}"/>
    </Style>
</Styles>
