<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sortacium.Presentation.Controls">

    <ControlTheme
        x:Key="BeveledBorder.Window"
        TargetType="controls:BeveledBorder">

        <Setter Property="Background"
                Value="{DynamicResource Brush.Window.Surface}"/>

        <Setter Property="CornerRadius"
                Value="{StaticResource CornerRadius.Window}"/>

        <Setter Property="BorderThickness"
                Value="{StaticResource Thickness.Border.Generic}"/>

        <Setter Property="StrokeHighlightColor"
                Value="{DynamicResource Color.Window.Highlight}"/>

        <Setter Property="StrokeShadowColor"
                Value="{DynamicResource Color.Window.Shadow}"/>

    </ControlTheme>

    <ControlTheme x:Key="BeveledBorder.Panel"
                  TargetType="controls:BeveledBorder">

        <Setter Property="CornerRadius"
                Value="{StaticResource CornerRadius.Panel}"/>

        <Setter Property="BorderThickness"
                Value="{StaticResource Thickness.Border.Generic}"/>

        <Setter Property="Padding"
                Value="{StaticResource Thickness.Panel.Padding}"/>

        <Setter Property="Background"
                Value="{DynamicResource Brush.Panel.Surface}"/>

        <Setter Property="StrokeHighlightColor"
                Value="{DynamicResource Color.Panel.Highlight}"/>

        <Setter Property="StrokeShadowColor"
                Value="{DynamicResource Color.Panel.Shadow}"/>

    </ControlTheme>

    <ControlTheme x:Key="BeveledBorder.DialogPanel"
                  TargetType="controls:BeveledBorder"
                  BasedOn="{StaticResource BeveledBorder.Panel}">

        <Setter Property="Padding"
                Value="{StaticResource Thickness.ModalPanel.Padding}"/>

        <Setter Property="MaxWidth"
                Value="1200"/>

    </ControlTheme>

    <ControlTheme x:Key="BeveledBorder.RecessedPanel"
                  TargetType="controls:BeveledBorder">

        <Setter Property="CornerRadius"
                Value="{StaticResource CornerRadius.RecessedPanel}"/>

        <Setter Property="BorderThickness"
                Value="{StaticResource Thickness.Border.Generic}"/>

        <Setter Property="Background"
                Value="{DynamicResource Brush.RecessedPanel.Surface}"/>

        <Setter Property="StrokeHighlightColor"
                Value="{DynamicResource Color.RecessedPanel.Highlight}"/>

        <Setter Property="StrokeShadowColor"
                Value="{DynamicResource Color.RecessedPanel.Shadow}"/>

        <Setter Property="Padding"
                Value="{StaticResource Thickness.Panel.Padding}"/>

    </ControlTheme>

</ResourceDictionary>
