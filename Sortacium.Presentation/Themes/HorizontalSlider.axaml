<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sortacium.Presentation.Controls">

    <ControlTheme
        x:Key="HorizontalSlider.SegmentTheme"
        TargetType="RepeatButton">

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="{TemplateBinding Background}"/>

            </ControlTemplate>

        </Setter>

    </ControlTheme>

    <!-- Thumb -->
    <ControlTheme
        x:Key="HorizontalSlider.ThumbTheme"
        TargetType="Thumb">

        <Setter
            Property="Transitions">

            <Transitions>

                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15"
                    Easing="CubicEaseOut"/>

            </Transitions>

        </Setter>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                    StartPoint="50%, 0%"
                    EndPoint="50%, 100%">

                    <GradientStop
                        Color="#AF4BE9"
                        Offset="0"/>

                    <GradientStop
                        Color="#8D40B9"
                        Offset="0.3"/>

                    <GradientStop
                        Color="#8D40B9"
                        Offset="0.7"/>

                    <GradientStop
                        Color="#5F2D7C"
                        Offset="1"/>

                </LinearGradientBrush>

            </Setter.Value>

        </Setter>

        <Setter
            Property="RenderTransform"
            Value="translateY(0px)"/>

        <Setter
            Property="Background"
            Value="#853CAE"/>

        <Setter
            Property="Width"
            Value="60"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <!-- Outer Border -->
                <Border
                    Background="#792FA4"
                    BorderThickness="0,0,2,0"
                    CornerRadius="0,10,10,0"
                    BorderBrush="#8539B1">

                    <!-- Inner Border -->
                    <Border
                        Name="PART_InnerBorder"
                        Background="#853CAE"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Margin="6"
                        RenderTransform="translateY(0px)">

                        <Border.BorderBrush>

                            <LinearGradientBrush
                                StartPoint="50%,0%"
                                EndPoint="50%,100%">

                                <GradientStop
                                    Color="#AF4BE9"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#8D40B9"
                                    Offset="0.3"/>

                                <GradientStop
                                    Color="#8D40B9"
                                    Offset="0.7"/>

                                <GradientStop
                                    Color="#5F2D7C"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>

                        <Border.Transitions>

                            <Transitions>

                                <BrushTransition
                                    Property="Background"
                                    Duration="0:0:0.2"
                                    Easing="CubicEaseOut"/>

                                <BrushTransition
                                    Property="BorderBrush"
                                    Duration="0:0:0.2"
                                    Easing="CubicEaseOut"/>

                                <TransformOperationsTransition
                                    Property="RenderTransform"
                                    Duration="0:0:0.15"
                                    Easing="CubicEaseOut"/>

                            </Transitions>

                        </Border.Transitions>

                    </Border>

                </Border>

            </ControlTemplate>

        </Setter>

        <Style
            Selector="^:pointerover">

            <Setter
                Property="Cursor"
                Value="Hand"/>

        </Style>

        <Style
            Selector="^:pressed /template/ Border#PART_InnerBorder">

            <Setter
                Property="Background"
                Value="#7B38A3"/>

            <Setter
                Property="RenderTransform"
                Value="translateY(-1px)"/>

            <Setter
                Property="BorderBrush">
                <Setter.Value>

                    <LinearGradientBrush
                        StartPoint="50%,0%"
                        EndPoint="50%,100%">

                        <GradientStop
                            Offset="0"
                            Color="#4E1F69"/>

                        <GradientStop
                            Offset="0.2"
                            Color="#713593"/>

                        <GradientStop
                            Offset="0.8"
                            Color="#713593"/>

                        <GradientStop
                            Offset="1"
                            Color="#9340C3"/>

                    </LinearGradientBrush>

                </Setter.Value>

            </Setter>

        </Style>

    </ControlTheme>

    <ControlTheme
        x:Key="{x:Type controls:HorizontalSlider}"
        TargetType="{x:Type controls:HorizontalSlider}">

        <Setter
            Property="FontSize"
            Value="16"/>

        <Setter
            Property="FontWeight"
            Value="Medium"/>

        <Setter
            Property="Foreground"
            Value="#EEE"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="#292929"
                    CornerRadius="18"
                    BorderThickness="1.5"
                    Padding="6, 6, 6, 7">

                    <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="#353535"
                                Offset="0"/>

                            <GradientStop
                                Color="#2B2B2B"
                                Offset="0.3"/>

                            <GradientStop
                                Color="#2B2B2B"
                                Offset="0.7"/>

                            <GradientStop
                                Color="#1B1B1B"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                    <Border
                        Background="#232323"
                        BorderThickness="1.5"
                        CornerRadius="14">

                        <Border.BorderBrush>

                            <LinearGradientBrush
                                StartPoint="50%, 0%"
                                EndPoint="50%, 100%">

                                <GradientStop
                                    Color="#212121"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#232323"
                                    Offset="0.1"/>

                                <GradientStop
                                    Color="#232323"
                                    Offset="0.95"/>

                                <GradientStop
                                    Color="#363636"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>

                        <Grid
                            ColumnDefinitions="Auto, *, Auto">

                            <Border
                                Background="#313131"
                                CornerRadius="13,0,0,13">

                                <TextBlock
                                    Text="{TemplateBinding Title}"
                                    IsHitTestVisible="False"
                                    Margin="10, 7, 10, 7"/>

                            </Border>

                            <Track
                                Name="PART_Track"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value, Mode=TwoWay}"
                                IsDirectionReversed="False">

                                <Track.DecreaseButton>

                                    <RepeatButton
                                        Name="PART_DecreaseButton"
                                        Theme="{StaticResource HorizontalSlider.SegmentTheme}"
                                        Focusable="False">

                                        <RepeatButton.Background>

                                            <LinearGradientBrush
                                                StartPoint="100%,50%"
                                                EndPoint="0%,50%">

                                                <GradientStop
                                                    Color="#792FA4"
                                                    Offset="0"/>

                                                <GradientStop
                                                    Color="#313131"
                                                    Offset="1"/>

                                            </LinearGradientBrush>

                                        </RepeatButton.Background>

                                    </RepeatButton>

                                </Track.DecreaseButton>

                                <Track.IncreaseButton>

                                    <RepeatButton
                                        Name="PART_IncreaseButton"
                                        Theme="{StaticResource HorizontalSlider.SegmentTheme}"
                                        Background="#202020"
                                        Focusable="False"/>

                                </Track.IncreaseButton>

                                <Track.Thumb>

                                    <Thumb
                                        Name="PART_Thumb"
                                        Theme="{StaticResource HorizontalSlider.ThumbTheme}"/>

                                </Track.Thumb>

                            </Track>

                            <Border
                                Grid.Column="2"
                                Background="#313131"
                                CornerRadius="0,13,13,0">

                                <StackPanel
                                    Orientation="Horizontal">

                                    <TextBlock
                                        Text="{Binding Value,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           StringFormat='{}{0:F0}'}"
                                        Margin="10, 7, 0, 7"/>

                                    <TextBlock
                                        Text="{TemplateBinding Suffix}"
                                        Margin="0, 7, 10, 7"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>

                </Border>

            </ControlTemplate>

        </Setter>

    </ControlTheme>

</ResourceDictionary>
