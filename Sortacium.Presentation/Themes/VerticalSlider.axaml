<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sortacium.Presentation.Controls">

     <ControlTheme
         x:Key="VerticalSlider.SegmentTheme"
         TargetType="RepeatButton">

         <Setter
             Property="Template">

             <ControlTemplate>
                 <Border
                     Background="{TemplateBinding Background}" />

             </ControlTemplate>

         </Setter>

    </ControlTheme>

    <!-- Thumb -->
    <ControlTheme
        x:Key="VerticalSlider.ThumbTheme"
        TargetType="Thumb">

        <Setter
            Property="Transitions">

            <Transitions>

                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.2"
                    Easing="CubicEaseOut"/>

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.15"
                    Easing="CubicEaseOut"/>

            </Transitions>

        </Setter>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                                StartPoint="50%, 0%"
                                EndPoint="50%, 100%">

                                <GradientStop
                                    Color="#AF4BE9"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#8D40B9"
                                    Offset="0.3"/>

                                <GradientStop
                                    Color="#8D40B9"
                                    Offset="0.7"/>

                                <GradientStop
                                    Color="#5F2D7C"
                                    Offset="1"/>

                            </LinearGradientBrush>

            </Setter.Value>

        </Setter>

        <Setter
            Property="RenderTransform"
            Value="translateY(0px)"/>

        <Setter
            Property="Background"
            Value="#853CAE"/>

        <Setter
            Property="Height"
            Value="36"/>

        <Setter Property="Template">
    <ControlTemplate>

        <!-- Outer Border -->
        <Border
            Background="#792FA4"
            BorderThickness="0,2,0,0"
            CornerRadius="10,10,0,0"
            BorderBrush="#8539B1">

            <!-- Inner Border -->
            <Border
                Name="PART_InnerBorder"
                Background="#853CAE"
                BorderThickness="1.5"
                CornerRadius="8"
                Margin="6"
                RenderTransform="translateY(0px)">

                <Border.BorderBrush>
                    <LinearGradientBrush
                        StartPoint="50%,0%"
                        EndPoint="50%,100%">

                        <GradientStop Color="#AF4BE9" Offset="0"/>
                        <GradientStop Color="#8D40B9" Offset="0.3"/>
                        <GradientStop Color="#8D40B9" Offset="0.7"/>
                        <GradientStop Color="#5F2D7C" Offset="1"/>

                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Border.Transitions>
                    <Transitions>

                        <BrushTransition
                            Property="Background"
                            Duration="0:0:0.2"
                            Easing="CubicEaseOut"/>

                        <BrushTransition
                            Property="BorderBrush"
                            Duration="0:0:0.2"
                            Easing="CubicEaseOut"/>

                        <TransformOperationsTransition
                            Property="RenderTransform"
                            Duration="0:0:0.15"
                            Easing="CubicEaseOut"/>

                    </Transitions>
                </Border.Transitions>

            </Border>

        </Border>

    </ControlTemplate>
</Setter>

        <!-- Hover -->
<Style Selector="^:pointerover">

    <Setter
        Property="Cursor"
        Value="Hand"/>

</Style>

<!-- Pressed -->
<Style Selector="^:pressed /template/ Border#PART_InnerBorder">

    <Setter
        Property="Background"
        Value="#7B38A3"/>

    <Setter
        Property="RenderTransform"
        Value="translateY(-1px)"/>

    <Setter Property="BorderBrush">
        <Setter.Value>

            <LinearGradientBrush
                StartPoint="50%,0%"
                EndPoint="50%,100%">

                <GradientStop
                    Offset="0"
                    Color="#4E1F69"/>

                <GradientStop
                    Offset="0.2"
                    Color="#713593"/>

                <GradientStop
                    Offset="0.8"
                    Color="#713593"/>

                <GradientStop
                    Offset="1"
                    Color="#9340C3"/>

            </LinearGradientBrush>

        </Setter.Value>
    </Setter>

</Style>

    </ControlTheme>

    <ControlTheme
        x:Key="{x:Type controls:VerticalSlider}"
        TargetType="{x:Type controls:VerticalSlider}">

        <Setter
            Property="Orientation"
            Value="Vertical"/>

        <Setter
            Property="Template">

            <ControlTemplate>

                <Border
                    Background="#292929"
                    CornerRadius="16"
                    BorderThickness="1.5"
                    Padding="6">

                    <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="#353535"
                                Offset="0"/>

                            <GradientStop
                                Color="#2B2B2B"
                                Offset="0.1"/>

                            <GradientStop
                                Color="#2B2B2B"
                                Offset="0.9"/>

                            <GradientStop
                                Color="#1B1B1B"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                    <Border
                        Background="#232323"
                        BorderThickness="1.5"
                        CornerRadius="14">

                        <Border.BorderBrush>

                              <LinearGradientBrush
                                StartPoint="50%, 0%"
                                EndPoint="50%, 100%">

                                <GradientStop
                                    Color="#1E1E1E"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#212121"
                                    Offset="0.1"/>

                                <GradientStop
                                    Color="#212121"
                                    Offset="0.8"/>

                                <GradientStop
                                    Color="#363636"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>

                        <Grid
                            RowDefinitions="Auto, *, Auto">

                            <Border
                                Background="#3A3A3A"
                                CornerRadius="13,13,0,0">

                                <TextBlock
                                    Text="{TemplateBinding Title}"
                                    FontSize="16"
                                    Foreground="#EEE"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Margin="0, 8, 0, 6"/>

                            </Border>

                            <Track
                                Name="PART_Track"
                                Grid.Row="1"
                                Orientation="Vertical"
                                Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   IsDirectionReversed="False">

                                 <Track.DecreaseButton>

                                    <RepeatButton
                                        Name="PART_DecreaseButton"
                                        Theme="{StaticResource VerticalSlider.SegmentTheme}"
                                        Focusable="False">

                                        <RepeatButton.Background>

                                            <LinearGradientBrush
                                                StartPoint="50%,0%"
                                                EndPoint="50%,100%">

                                                <GradientStop
                                                    Color="#792FA4"
                                                    Offset="0" />

                                                <GradientStop
                                                    Color="#3A3A3A"
                                                    Offset="1" />

                                            </LinearGradientBrush>

                                        </RepeatButton.Background>

                                    </RepeatButton>

                                </Track.DecreaseButton>

                                  <Track.IncreaseButton>

                                    <RepeatButton
                                        Name="PART_IncreaseButton"
                                        Theme="{StaticResource VerticalSlider.SegmentTheme}"
                                        Background="#202020"
                                        Focusable="False" />

                                </Track.IncreaseButton>

                                <Track.Thumb>

                                    <Thumb
                                        Name="PART_Thumb"
                                        Theme="{StaticResource VerticalSlider.ThumbTheme}"/>

                                </Track.Thumb>

                            </Track>

                            <Border
                                Grid.Row="2"
                                Background="#3A3A3A"
                                CornerRadius="0,0,13,13">

                                <TextBlock
                                    Text="{Binding Value,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           StringFormat='{}{0:F0}'}"
                                    FontSize="16"
                                    Foreground="#EEE"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0, 6, 0, 8"/>

                            </Border>

                        </Grid>

                    </Border>

                </Border>

            </ControlTemplate>

        </Setter>

    </ControlTheme>

</ResourceDictionary>
