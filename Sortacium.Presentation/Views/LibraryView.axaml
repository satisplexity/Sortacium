<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Sortacium.Presentation.ViewModels"
    xmlns:models="using:Sortacium.Presentation.Models"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components"
    x:Class="Sortacium.Presentation.Views.LibraryView"
    x:DataType="vm:LibraryViewModel"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="600">

    <Grid
        RowDefinitions="auto, *, auto"
        RowSpacing="10">

        <TextBlock
            Text="{DynamicResource L.SelectAlgorithm}"
            FontSize="24"
            FontWeight="Bold"
            Foreground="{DynamicResource Brush.Text.Strong}"/>

        <controls:IconButton
            Click="Close_Click"
            HorizontalAlignment="Right"
            Icon="{StaticResource Icon.Close}"/>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*, 700"
            ColumnSpacing="20">

            <controls:BeveledBorder
                Theme="{StaticResource BeveledBorder.RecessedPanel}">

                <ListBox
                    Classes="algorithm-list"
                    Theme="{StaticResource StyledListBox}"
                    ItemsSource="{Binding AvailableAlgorithms}"
                    SelectedItem="{Binding PreviewAlgorithm, Mode=TwoWay}">

                    <ListBox.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:AlgorithmOption">

                            <StackPanel
                                Spacing="5">

                                <TextBlock
                                    Text="{Binding Name}"
                                    TextWrapping="Wrap"
                                    FontWeight="Bold"
                                    FontSize="16"/>

                                <TextBlock
                                    Text="{Binding Description}"
                                    Foreground="{DynamicResource Brush.Text.Muted}"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    MaxLines="2"/>

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </controls:BeveledBorder>

            <Grid
                Grid.Column="1"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="14">

                <TextBlock
                    Text="{Binding PreviewAlgorithm.Name}"
                    Foreground="{DynamicResource Brush.Accent.Primary}"
                    FontSize="26"
                    FontWeight="Bold"/>

                <TextBlock
                    Grid.Row="1"
                    Text="{Binding PreviewAlgorithm.Description}"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource Brush.Text.Description}"/>

                <!-- Complexity and history -->
                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="18"
                    RowSpacing="8">

                    <TextBlock
                        Text="{DynamicResource L.Author}"
                        Foreground="{DynamicResource Brush.Text.Placeholder}"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding PreviewAlgorithm.Author}"
                        Foreground="{DynamicResource Brush.Text.Detail}"/>

                    <TextBlock
                        Grid.Row="1"
                        Text="{DynamicResource L.Year}"
                        Foreground="{DynamicResource Brush.Text.Placeholder}"/>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding PreviewAlgorithm.Year}"
                        Foreground="{DynamicResource Brush.Text.Detail}"/>

                    <TextBlock
                        Grid.Row="2"
                        Text="{DynamicResource L.TimeComplexity}"
                        Foreground="{DynamicResource Brush.Text.Placeholder}"/>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">

                        <TextBlock
                            Text="{Binding PreviewAlgorithm.BestTime}"
                            Foreground="{DynamicResource Brush.Text.Positive}"/>

                        <TextBlock
                            Text="{Binding PreviewAlgorithm.AverageTime}"
                            Foreground="{DynamicResource Brush.Text.Detail}"/>

                        <TextBlock
                            Text="{Binding PreviewAlgorithm.WorstTime}"
                            Foreground="{DynamicResource Brush.Text.Negative}"/>

                    </StackPanel>

                    <TextBlock
                        Grid.Row="3"
                        Text="{DynamicResource L.SpaceComplexity}"
                        Foreground="{DynamicResource Brush.Text.Placeholder}"/>

                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="14">

                        <TextBlock
                            Text="{Binding PreviewAlgorithm.SpaceComplexity}"
                            Foreground="{DynamicResource Brush.Text.Detail}"/>

                        <TextBlock
                            Text="{Binding PreviewAlgorithm.Stability}"
                            Foreground="{DynamicResource Brush.Accent.Primary}"/>

                    </StackPanel>

                </Grid>

                <!-- Code viewer -->
                <Grid
                    Grid.Row="3"
                    RowDefinitions="Auto,*"
                    RowSpacing="8">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <TextBlock
                            Text="{DynamicResource L.Implementation}"
                            Foreground="{DynamicResource Brush.Accent.Primary}"
                            FontSize="16"
                            FontWeight="Medium"
                            VerticalAlignment="Center"/>

                        <controls:StyledComboBox
                            Grid.Column="1"
                            Width="145"
                            ItemsSource="{Binding PreviewAvailableLanguages}"
                            SelectedItem="{Binding PreviewLanguage, Mode=TwoWay}">

                            <controls:StyledComboBox.ItemTemplate>

                                <DataTemplate
                                    x:DataType="vm:CodeLanguageOption">

                                    <TextBlock
                                        Text="{Binding DisplayName}"/>

                                </DataTemplate>

                            </controls:StyledComboBox.ItemTemplate>

                        </controls:StyledComboBox>

                    </Grid>

                    <controls:BeveledBorder
                        Theme="{StaticResource BeveledBorder.RecessedPanel}"
                        Grid.Row="1"
                        ClipToBounds="True">

                        <controls:SortingCodeEditor
                            Language="{Binding PreviewLanguage.Id}"
                            Document="{Binding PreviewCodeDocument}"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.Accent.Primary}"
                            FontFamily="Consolas, Menlo, Monospace"
                            FontSize="13"
                            LineNumbersForeground="{DynamicResource Brush.Text.LineNumber}"/>

                    </controls:BeveledBorder>

                </Grid>

            </Grid>

        </Grid>

        <!-- Footer -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto">

            <TextBlock
                Text="{DynamicResource L.ResetWarning}"
                TextWrapping="Wrap"
                Margin="0,0,16,0"
                Foreground="{DynamicResource Brush.Text.Subtle}"
                VerticalAlignment="Center"
                FontSize="12"/>

            <controls:IconButton
                Grid.Column="1"
                Text="{DynamicResource L.UseAlgorithm}"
                Icon="{StaticResource Icon.Check}"
                HorizontalAlignment="Right"
                Click="Apply_Click"
                FontSize="14"
                FontWeight="Bold"
                Height="50"/>

        </Grid>

    </Grid>

</UserControl>
