<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sortacium.Presentation.ViewModels"
        xmlns:controls="using:Sortacium.Presentation.Controls"
        x:Class="Sortacium.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sortacium"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000"
        Height="650"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        CanResize="True"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Border CornerRadius="15"
            Background="{StaticResource Brush.WindowBackground}"
            BorderThickness="2">
       <Border.BorderBrush>
           
           <LinearGradientBrush StartPoint="50%, 0%"
                                EndPoint="50%, 100%">
               
               <GradientStop Color="#272727"
                             Offset="0"/>

               <GradientStop Color="{StaticResource Color.TitleBarBackground}"
                             Offset="0.1"/>

               <GradientStop Color="{StaticResource Color.WindowBackground}"
                             Offset="0.9"/>

               <GradientStop Color="#151515"
                             Offset="1"/>

           </LinearGradientBrush>

       </Border.BorderBrush>

    <Grid>

        <Grid
            RowDefinitions="auto,*">

            <Border
                Grid.Row="0"
                Background="{StaticResource Brush.TitleBarBackground}"
                WindowDecorationProperties.ElementRole="TitleBar"
                Padding="10"
                CornerRadius="15, 15, 0, 0">

                <Grid
                    ColumnDefinitions="*,auto,*">
                    
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        
                        <TextBlock Text="Sortacium"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#88E"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel
                        Spacing="10"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        WindowDecorationProperties.ElementRole="User">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Shuffle}"/>

                        <controls:IconButton Icon="{StaticResource Icon.Play}"
                                             Command="{Binding BubbleSortCommand}"/>
                        <controls:IconButton Icon="{StaticResource Icon.Pause}"/>

                        <controls:IconButton Icon="{StaticResource Icon.Force}"/>
                        <controls:IconButton Icon="{StaticResource Icon.Previous}"/>
                        <controls:IconButton Icon="{StaticResource Icon.Next}"/>

                    </StackPanel>

                    <StackPanel
                        Spacing="10"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                        
                        <controls:IconButton
                            Icon="{StaticResource Icon.Settings}"
                            WindowDecorationProperties.ElementRole="User"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Minimize}"
                            Click="Minimize_Click"
                            WindowDecorationProperties.ElementRole="MinimizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Maximize}"
                            Click="Maximize_Click"
                            WindowDecorationProperties.ElementRole="MaximizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Close}"
                            Click="Close_Click"
                            WindowDecorationProperties.ElementRole="CloseButton"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,*"
                  Margin="16">

                <controls:BarsRenderer
                    Grid.Row="1"
                    Bars="{Binding Bars}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <Border Width="6"
                HorizontalAlignment="Left"
                Background="Transparent"
                Cursor="SizeWestEast"
                WindowDecorationProperties.ElementRole="ResizeW"/>

        <Border Width="6"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="SizeWestEast"
                WindowDecorationProperties.ElementRole="ResizeE"/>

        <Border Height="6"
                VerticalAlignment="Top"
                Background="Transparent"
                Cursor="SizeNorthSouth"
                WindowDecorationProperties.ElementRole="ResizeN"/>

        <Border Height="6"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNorthSouth"
                WindowDecorationProperties.ElementRole="ResizeS"/>

        <Border Width="10" Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopLeftCorner"
                WindowDecorationProperties.ElementRole="ResizeNW"/>

        <Border Width="10" Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopRightCorner"
                WindowDecorationProperties.ElementRole="ResizeNE"/>

        <Border Width="10" Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomLeftCorner"
                WindowDecorationProperties.ElementRole="ResizeSW"/>

        <Border Width="10" Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomRightCorner"
                WindowDecorationProperties.ElementRole="ResizeSE"/>

    </Grid>

    </Border>
</Window>
