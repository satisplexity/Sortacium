<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaedit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sortacium.Presentation.ViewModels"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components"
    xmlns:models="using:Sortacium.Presentation.Models"
    xmlns:views="using:Sortacium.Presentation.Views"
    x:Class="Sortacium.Presentation.Views.MainWindow"
    x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style
            Selector="Border#ModalScrim">

            <Setter
                Property="Opacity"
                Value="0"/>

        </Style>

        <Style
            Selector="Border#ModalScrim.open">

            <Setter
                Property="Opacity"
                Value="1"/>

        </Style>

        <!-- Default code line -->
        <Style
            Selector="Border.code-line">

            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Accent.Highlight.Transparent}"/>

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource Brush.Accent.Primary.Transparent}"/>

        </Style>

        <!-- Active code line -->
        <Style
            Selector="Border.code-line.active">

            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Accent.Highlight}"/>

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource Brush.Accent.Primary}"/>

        </Style>

        <!-- Default code text -->
        <Style
            Selector="TextBlock.code-text">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Code}"/>
        </Style>

        <!-- Active code text -->
        <Style
            Selector="Border.code-line.active TextBlock.code-text">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Accent.Text.Hover}"/>
        </Style>

    </Window.Styles>

    <Grid>

        <Grid
            Name="MainContent"
            RowDefinitions="auto,*">

            <Border Theme="{StaticResource Border.WindowTitleBar}">

                <Grid
                    ColumnDefinitions="*,auto,*">

                    <!-- Application title -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Sortacium"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Accent.Primary}"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- Sorting controls -->
                    <StackPanel
                        Spacing="10"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        WindowDecorationProperties.ElementRole="User">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Shuffle}"
                            Command="{Binding ShuffleCommand}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Play}"
                            Command="{Binding PlayCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Pause}"
                            Command="{Binding PauseCommand}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Force}"
                            Command="{Binding ForceToEndCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Previous}"
                            Command="{Binding PreviousStepCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Next}"
                            Command="{Binding NextStepCommand}"
                            IsEnabled="{Binding IsReady}"/>

                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel
                        Spacing="10"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Settings}"
                            WindowDecorationProperties.ElementRole="User"
                            Click="OpenSettings_Click"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Minimize}"
                            Click="Minimize_Click"
                            WindowDecorationProperties.ElementRole="MinimizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Maximize}"
                            Click="Maximize_Click"
                            WindowDecorationProperties.ElementRole="MaximizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.PowerOff}"
                            Click="Close_Click"
                            WindowDecorationProperties.ElementRole="CloseButton"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid
                Margin="10"
                Grid.Row="1"
                ColumnDefinitions="auto, *, auto">

                <!-- Control panel -->
                <controls:BeveledBorder
                    Theme="{StaticResource BeveledBorder.Panel}"
                    Width="300">

                    <Grid
                        RowDefinitions="*, auto">

                        <StackPanel
                            Spacing="10">

                            <TextBlock
                                Text="{DynamicResource L.SelectedAlgorithm}"
                                Foreground="{DynamicResource Brush.Text.Muted}"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding SelectedAlgorithm.Name}"
                                FontSize="24"
                                Foreground="{DynamicResource Brush.Accent.Primary}"
                                FontWeight="Bold"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>

                            <Grid
                                ColumnDefinitions="*, *"
                                Height="300"
                                ColumnSpacing="10">

                                <controls:VerticalSlider
                                    Title="{DynamicResource L.Count}"
                                    Minimum="5"
                                    Maximum="100"
                                    Value="{Binding Count}"/>

                                <controls:VerticalSlider
                                    Title="{DynamicResource L.Speed}"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="{Binding Speed, Mode=TwoWay}"
                                    Suffix="{DynamicResource L.OpsPerSecond}"/>

                            </Grid>

                        </StackPanel>

                        <controls:IconButton
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Text="{DynamicResource L.SelectAlgorithm}"
                            Icon="{StaticResource Icon.Change}"
                            Foreground="{DynamicResource Brush.Text.Strong}"
                            Padding="20"
                            HorizontalContentAlignment="Center"
                            CornerRadius="10"
                            FontSize="14"
                            Click="OpenAlgorithmSelection_Click"/>

                    </Grid>

                </controls:BeveledBorder>

                <Grid
                    Grid.Column="1"
                    Margin="15"
                    RowDefinitions="*,Auto,Auto"
                    RowSpacing="12">

                    <controls:BarsRenderer
                        Grid.Row="0"
                        Bars="{Binding Bars}"
                        SnapVersion="{Binding SnapVersion}"
                        OperationsPerSecond="{Binding Speed}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                    <controls:HorizontalSlider
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="{Binding TotalSteps}"
                        Value="{Binding TimelinePosition, Mode=TwoWay}"
                        Title="{DynamicResource L.Step}"
                        Suffix="{Binding TotalSteps, StringFormat=' / {0}'}"
                        IsEnabled="{Binding IsReady}"/>

                </Grid>

                <controls:BeveledBorder
                    Grid.Column="2"
                    Width="420"
                    Theme="{StaticResource BeveledBorder.Panel}">

                    <Grid
                        RowDefinitions="Auto,*,Auto"
                        RowSpacing="12">

                        <!-- Header -->
                        <Grid
                            ColumnDefinitions="*,Auto">

                            <controls:StyledComboBox
                                Grid.Column="1"
                                MinWidth="145"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding AvailableLanguages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">

                                <controls:StyledComboBox.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:CodeLanguageOption">
                                        <TextBlock
                                            Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </controls:StyledComboBox.ItemTemplate>

                            </controls:StyledComboBox>

                        </Grid>

                        <!-- Code viewer -->
                        <controls:BeveledBorder
                            Grid.Row="1"
                            Theme="{StaticResource BeveledBorder.RecessedPanel}">

                            <controls:SortingCodeEditor
                                x:Name="CodeEditor"
                                Language="{Binding SelectedLanguage.Id}"
                                Document="{Binding CodeDocument}"
                                HighlightedLines="{Binding HighlightedCodeLines}"
                                Background="Transparent"
                                Foreground="{DynamicResource Brush.Text.Code}"
                                FontFamily="Consolas, Menlo, Monospace"
                                FontSize="14"
                                LineNumbersForeground="{DynamicResource Brush.Text.LineNumber}"/>

                        </controls:BeveledBorder>

                        <!-- Statistics -->
                        <StackPanel
                            Grid.Row="2"
                            Spacing="8">

                            <Border
                                Background="{DynamicResource Brush.Surface.Hover}"
                                Height="1"/>

                            <TextBlock
                                Text="{DynamicResource L.ExecutionDetails}"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Brush.Text.Strong}"/>

                            <Grid
                                ColumnDefinitions="*,*">

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{DynamicResource L.Comparisons}" Foreground="{DynamicResource Brush.Text.Code}"/>
                                    <TextBlock Text="{Binding ComparisonCount}" Foreground="{DynamicResource Brush.Text.Code}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{DynamicResource L.Swaps}" Foreground="{DynamicResource Brush.Text.Code}"/>
                                    <TextBlock Text="{Binding SwapCount}" Foreground="{DynamicResource Brush.Text.Code}"/>
                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Text="{Binding VariablesDescription}"
                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                FontFamily="Consolas, Menlo, DejaVu Sans Mono"
                                FontSize="12"/>

                        </StackPanel>

                    </Grid>

                </controls:BeveledBorder>

            </Grid>

        </Grid>

        <Grid
            x:Name="ModalOverlay"
            IsHitTestVisible="False">

            <Border x:Name="ModalScrim"
                    Background="{DynamicResource Brush.Overlay.Scrim}"
                    CornerRadius="{StaticResource CornerRadius.Window}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity"
                                          Duration="0:0:0.25"
                                          Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>
            </Border>

            <Grid Margin="50">

                <controls:BeveledBorder
                    x:Name="SettingsDialog"
                    IsVisible="False"
                    Theme="{StaticResource BeveledBorder.DialogPanel}">

                    <views:SettingsView
                        CloseRequested="SettingsView_CloseRequested"/>

                </controls:BeveledBorder>

                <controls:BeveledBorder
                    x:Name="AlgorithmSelectionDialog"
                    IsVisible="False"
                    Theme="{StaticResource BeveledBorder.DialogPanel}">

                    <views:LibraryView
                        DataContext="{Binding Library}"
                        CloseRequested="AlgorithmSelectionView_CloseRequested"
                        ApplyRequested="AlgorithmSelectionView_ApplyRequested"/>

                </controls:BeveledBorder>

            </Grid>

        </Grid>

    </Grid>

</Window>
