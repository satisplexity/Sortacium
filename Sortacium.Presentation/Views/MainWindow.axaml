<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaedit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sortacium.Presentation.ViewModels"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components"
    xmlns:models="using:Sortacium.Presentation.Models"
    xmlns:views="using:Sortacium.Presentation.Views"
    x:Class="Sortacium.Presentation.Views.MainWindow"
    x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style
            Selector="Border#ModalOverlay">

            <Setter
                Property="Opacity"
                Value="0"/>

        </Style>

        <Style
            Selector="Border#ModalOverlay.open">

            <Setter
                Property="Opacity"
                Value="1"/>

        </Style>

        <Style
            Selector="Border#SettingsDialog">

            <Setter
                Property="Opacity"
                Value="0"/>

            <Setter
                Property="RenderTransform"
                Value="scale(0.9) translateY(-70px) translateX(70px)"/>

        </Style>

        <Style
            Selector="Border#SettingsDialog.open">

            <Setter
                Property="Opacity"
                Value="1"/>

            <Setter
                Property="RenderTransform"
                Value="scale(1) translateY(0px) translateX(0px)"/>

        </Style>

        <Style
            Selector="Border#AlgorithmSelectionDialog">

            <Setter
                Property="Opacity"
                Value="0"/>

            <Setter
                Property="RenderTransform"
                Value="scale(0.9) translateY(200px) translateX(-100px)"/>

        </Style>

        <Style
            Selector="Border#AlgorithmSelectionDialog.open">

            <Setter
                Property="Opacity"
                Value="1"/>

            <Setter
                Property="RenderTransform"
                Value="scale(1) translateY(0px) translateX(0px)"/>

        </Style>

        <!-- Default code line -->
        <Style
            Selector="Border.code-line">

            <Setter
                Property="Background"
                Value="#003D204D"/>

            <Setter
                Property="BorderBrush"
                Value="#00AF4BE9"/>

        </Style>

        <!-- Active code line -->
        <Style
            Selector="Border.code-line.active">

            <Setter
                Property="Background"
                Value="#3D204D"/>

            <Setter
                Property="BorderBrush"
                Value="#AF4BE9"/>

        </Style>

        <!-- Default code text -->
        <Style
            Selector="TextBlock.code-text">
            <Setter
                Property="Foreground"
                Value="#CCCCCC"/>
        </Style>

        <!-- Active code text -->
        <Style
            Selector="Border.code-line.active TextBlock.code-text">
            <Setter
                Property="Foreground"
                Value="#C18DDF"/>
        </Style>

    </Window.Styles>

    <Grid>

        <Grid
            Name="MainContent"
            RowDefinitions="auto,*">

            <Border
                Grid.Row="0"
                Background="{StaticResource Brush.TitleBarBackground}"
                WindowDecorationProperties.ElementRole="TitleBar"
                Padding="10"
                CornerRadius="15, 15, 0, 0"
                BorderThickness="0, 0, 0, 3"
                BorderBrush="#171717">

                <Grid
                    ColumnDefinitions="*,auto,*">

                    <!-- Application title -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Sortacium"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#AF4BE9"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- Sorting controls -->
                    <StackPanel
                        Spacing="10"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        WindowDecorationProperties.ElementRole="User">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Shuffle}"
                            Command="{Binding ShuffleCommand}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Play}"
                            Command="{Binding PlayCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Pause}"
                            Command="{Binding PauseCommand}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Force}"
                            Command="{Binding ForceToEndCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Previous}"
                            Command="{Binding PreviousStepCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Next}"
                            Command="{Binding NextStepCommand}"
                            IsEnabled="{Binding IsReady}"/>

                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel
                        Spacing="10"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Settings}"
                            WindowDecorationProperties.ElementRole="User"
                            Click="OpenSettings_Click"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Minimize}"
                            Click="Minimize_Click"
                            WindowDecorationProperties.ElementRole="MinimizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Maximize}"
                            Click="Maximize_Click"
                            WindowDecorationProperties.ElementRole="MaximizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.PowerOff}"
                            Click="Close_Click"
                            WindowDecorationProperties.ElementRole="CloseButton"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid
                Margin="10"
                Grid.Row="1"
                ColumnDefinitions="auto, *, auto">

                <!-- Control panel -->
                <Border
                    Theme="{StaticResource ContentContainer}"
                    Width="300">

                    <Grid
                        RowDefinitions="*, auto">

                        <StackPanel
                            Margin="15"
                            Spacing="10">

                            <TextBlock
                                Text="Selected sorting algorithm"
                                Foreground="#999"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding SelectedAlgorithm.Name}"
                                FontSize="24"
                                Foreground="#AF4BE9"
                                FontWeight="Bold"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>

                            <Grid
                                ColumnDefinitions="*, *"
                                Height="300"
                                ColumnSpacing="10">

                                <controls:VerticalSlider
                                    Title="Count"
                                    Minimum="5"
                                    Maximum="100"
                                    Value="{Binding Count}"/>

                                <controls:VerticalSlider
                                    Title="Speed"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="{Binding Speed, Mode=TwoWay}"
                                    Suffix=" op/s"/>

                            </Grid>

                        </StackPanel>

                        <Button
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Content="Select algrorithm"
                            Foreground="#EEE"
                            Padding="20"
                            HorizontalContentAlignment="Center"
                            CornerRadius="10"
                            FontSize="14"
                            Click="OpenAlgorithmSelection_Click"/>

                    </Grid>

                </Border>

                <Grid
                    Grid.Column="1"
                    Margin="15"
                    RowDefinitions="*,Auto,Auto"
                    RowSpacing="12">

                    <controls:BarsRenderer
                        Grid.Row="0"
                        Bars="{Binding Bars}"
                        SnapVersion="{Binding SnapVersion}"
                        OperationsPerSecond="{Binding Speed}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                    <controls:HorizontalSlider
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="{Binding TotalSteps}"
                        Value="{Binding TimelinePosition, Mode=TwoWay}"
                        Title="Step"
                        Suffix="{Binding TotalSteps, StringFormat=' / {0}'}"
                        IsEnabled="{Binding IsReady}"/>

                </Grid>

                <Border
                    Grid.Column="2"
                    Width="420"
                    Theme="{StaticResource ContentContainer}">

                    <Grid
                        RowDefinitions="Auto,*,Auto"
                        RowSpacing="12">

                        <!-- Header -->
                        <Grid
                            ColumnDefinitions="*,Auto">

                            <ComboBox
                                Grid.Column="1"
                                MinWidth="145"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding AvailableLanguages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:CodeLanguageOption">
                                        <TextBlock
                                            Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </Grid>

                        <!-- Code viewer -->
                        <Border
                            Grid.Row="1"
                            Theme="{StaticResource TextEditorContainer}">

                            <controls:SortingCodeEditor
                                x:Name="CodeEditor"
                                Language="{Binding SelectedLanguage.Id}"
                                Document="{Binding CodeDocument}"
                                HighlightedLines="{Binding HighlightedCodeLines}"
                                Background="Transparent"
                                Foreground="#CCCCCC"
                                FontFamily="Consolas, Menlo, Monospace"
                                FontSize="14"
                                LineNumbersForeground="#666666"/>

                        </Border>

                        <!-- Statistics -->
                        <StackPanel
                            Grid.Row="2"
                            Spacing="8">

                            <Border
                                Background="#303030"
                                Height="1"/>

                            <TextBlock
                                Text="Execution details"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="#EEEEEE"/>

                            <Grid
                                ColumnDefinitions="*,*">

                                <TextBlock
                                    Text="{Binding ComparisonCount, StringFormat='Comparisons: {0}'}"
                                    Foreground="#CCCCCC"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding SwapCount, StringFormat='Swaps: {0}'}"
                                    Foreground="#CCCCCC"/>

                            </Grid>

                            <TextBlock
                                Text="{Binding VariablesDescription}"
                                Foreground="#AAAAAA"
                                FontFamily="Consolas, Menlo, DejaVu Sans Mono"
                                FontSize="12"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <Border
            x:Name="ModalOverlay"
            Background="#55000000"
            CornerRadius="15"
            IsHitTestVisible="False">

            <Border.Transitions>

                <Transitions>

                    <DoubleTransition
                        Property="Opacity"
                        Duration="0:0:0.25"
                        Easing="CubicEaseOut"/>

                </Transitions>

            </Border.Transitions>

            <Grid>

                <Border
                    x:Name="SettingsDialog"
                    Width="800"
                    Margin="50"
                    Padding="24"
                    CornerRadius="12"
                    Background="#242424"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="50%,50%"
                    BorderThickness="1.5"
                    components:StrokeGradientAdapter.Enable="True">

                    <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="#2E2E2E"
                                Offset="0"/>

                            <GradientStop
                                Color="#262626"
                                Offset="0.2"/>

                            <GradientStop
                                Color="#262626"
                                Offset="0.8"/>

                            <GradientStop
                                Color="#1E1E1E"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                    <Border.Transitions>

                        <Transitions>

                            <DoubleTransition
                                Property="Opacity"
                                Duration="0:0:0.25"
                                Easing="CubicEaseOut"/>

                            <TransformOperationsTransition
                                Property="RenderTransform"
                                Duration="0:0:0.4">

                                <TransformOperationsTransition.Easing>

                                    <components:EnchancedBackEaseOut
                                        Amplitude="0.4"/>

                                </TransformOperationsTransition.Easing>

                            </TransformOperationsTransition>

                        </Transitions>

                    </Border.Transitions>

                    <views:SettingsView
                        CloseRequested="SettingsView_CloseRequested"/>

                </Border>

                <Border
                    x:Name="AlgorithmSelectionDialog"
                    MaxWidth="1000"
                    Margin="50"
                    Padding="24"
                    CornerRadius="12"
                    Background="#1E1E1E"
                    HorizontalAlignment="Stretch"
                    RenderTransformOrigin="50%,50%"
                    BorderThickness="3"
                    components:StrokeGradientAdapter.Enable="True">

                    <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="#2E2E2E"
                                Offset="0"/>

                            <GradientStop
                                Color="#1E1E1E"
                                Offset="0.2"/>

                            <GradientStop
                                Color="#1E1E1E"
                                Offset="0.8"/>

                            <GradientStop
                                Color="#151515"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                    <Border.Transitions>

                        <Transitions>

                            <DoubleTransition
                                Property="Opacity"
                                Duration="0:0:0.25"
                                Easing="CubicEaseOut"/>

                            <TransformOperationsTransition
                                Property="RenderTransform"
                                Duration="0:0:0.4">

                                <TransformOperationsTransition.Easing>

                                    <components:EnchancedBackEaseOut
                                        Amplitude="0.4"/>

                                </TransformOperationsTransition.Easing>

                            </TransformOperationsTransition>

                        </Transitions>

                    </Border.Transitions>

                    <views:LibraryView
                        DataContext="{Binding Library}"
                        CloseRequested="AlgorithmSelectionView_CloseRequested"
                        ApplyRequested="AlgorithmSelectionView_ApplyRequested"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>
