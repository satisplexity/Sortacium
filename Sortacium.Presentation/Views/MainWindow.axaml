<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sortacium.Presentation.ViewModels"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    x:Class="Sortacium.Presentation.Views.MainWindow"
    x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid
        RowDefinitions="auto,*">

        <Border
            Grid.Row="0"
            Background="{StaticResource Brush.TitleBarBackground}"
            WindowDecorationProperties.ElementRole="TitleBar"
            Padding="10"
            CornerRadius="15, 15, 0, 0"
            BorderThickness="0, 0, 0, 3"
            BorderBrush="#171717">

            <Grid
                ColumnDefinitions="*,auto,*">

                <!-- Application title -->
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Sortacium"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#88E"
                        VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Sorting controls -->
                <StackPanel
                    Spacing="10"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    WindowDecorationProperties.ElementRole="User">

                    <controls:IconButton
                        Icon="{StaticResource Icon.Shuffle}"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Play}"
                        Command="{Binding BubbleSortCommand}"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Pause}"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Force}"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Previous}"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Next}"/>

                </StackPanel>

                <!-- Window controls -->
                <StackPanel
                    Spacing="10"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <controls:IconButton
                        Icon="{StaticResource Icon.Settings}"
                        WindowDecorationProperties.ElementRole="User"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Minimize}"
                        Click="Minimize_Click"
                        WindowDecorationProperties.ElementRole="MinimizeButton"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Maximize}"
                        Click="Maximize_Click"
                        WindowDecorationProperties.ElementRole="MaximizeButton"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Close}"
                        Click="Close_Click"
                        WindowDecorationProperties.ElementRole="CloseButton"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="auto, *, auto">

            <Border
                CornerRadius="15"
                Background="{StaticResource Brush.TitleBarBackground}"
                Width="300"
                Margin="10"
                BorderThickness="1.5">

                <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="#272727"
                                Offset="0"/>

                            <GradientStop
                                Color="{StaticResource Color.TitleBarBackground}"
                                Offset="0.1"/>

                            <GradientStop
                                Color="{StaticResource Color.WindowBackground}"
                                Offset="0.9"/>

                            <GradientStop
                                Color="#151515"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                <StackPanel>

                    <TextBlock Text="Selected sort"/>

                    <controls:HorizontalSlider
                        Title="Amount"/>

                </StackPanel>

            </Border>

            <controls:BarsRenderer
                Margin="15"
                Grid.Column="1"
                Bars="{Binding Bars}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

            <Border
                Grid.Column="2"
                CornerRadius="15"
                Background="{StaticResource Brush.TitleBarBackground}"
                Width="300"
                Margin="10">
                
            </Border
>

        </Grid>

    </Grid>

</Window>
