<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sortacium.Presentation.ViewModels"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components"
    x:Class="Sortacium.Presentation.Views.MainWindow"
    x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>



    <Window.Styles>

        <!-- Затемнение фона -->
    <Style Selector="Border#ModalOverlay">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="Border#ModalOverlay.open">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Окно настроек -->
    <Style Selector="Border#SettingsDialog">
        <Setter Property="Opacity" Value="0" />
        <Setter
            Property="RenderTransform"
            Value="scale(0.9) translateY(30px)" />
    </Style>

    <Style Selector="Border#SettingsDialog.open">
        <Setter Property="Opacity" Value="1" />
        <Setter
            Property="RenderTransform"
            Value="scale(1) translateY(0px)" />
    </Style>

    </Window.Styles>

    <Grid>

        <Grid
            Name="MainContent"
            RowDefinitions="auto,*">

            <Border
                Grid.Row="0"
                Background="{StaticResource Brush.TitleBarBackground}"
                WindowDecorationProperties.ElementRole="TitleBar"
                Padding="10"
                CornerRadius="15, 15, 0, 0"
                BorderThickness="0, 0, 0, 3"
                BorderBrush="#171717">

                <Grid
                ColumnDefinitions="*,auto,*">

                <!-- Application title -->
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Sortacium"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#AF4BE9"
                        VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Sorting controls -->
                <StackPanel
                    Spacing="10"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    WindowDecorationProperties.ElementRole="User">

                    <controls:IconButton
    Icon="{StaticResource Icon.Shuffle}"
    Command="{Binding ShuffleCommand}" />

<controls:IconButton
    Icon="{StaticResource Icon.Play}"
    Command="{Binding PlayCommand}"
    IsEnabled="{Binding IsReady}" />

<controls:IconButton
    Icon="{StaticResource Icon.Pause}"
    Command="{Binding PauseCommand}" />

<controls:IconButton
    Icon="{StaticResource Icon.Force}"
    Command="{Binding ForceToEndCommand}"
    IsEnabled="{Binding IsReady}" />

<controls:IconButton
    Icon="{StaticResource Icon.Previous}"
    Command="{Binding PreviousStepCommand}"
    IsEnabled="{Binding IsReady}" />

<controls:IconButton
    Icon="{StaticResource Icon.Next}"
    Command="{Binding NextStepCommand}"
    IsEnabled="{Binding IsReady}" />    

                </StackPanel>

                <!-- Window controls -->
                <StackPanel
                    Spacing="10"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <controls:IconButton
                        Icon="{StaticResource Icon.Settings}"
                        WindowDecorationProperties.ElementRole="User"
                        Click="OpenSettings_Click"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Minimize}"
                        Click="Minimize_Click"
                        WindowDecorationProperties.ElementRole="MinimizeButton"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Maximize}"
                        Click="Maximize_Click"
                        WindowDecorationProperties.ElementRole="MaximizeButton"/>

                    <controls:IconButton
                        Icon="{StaticResource Icon.Close}"
                        Click="Close_Click"
                        WindowDecorationProperties.ElementRole="CloseButton"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="auto, *, auto">

            <Border
                CornerRadius="15"
                Background="{StaticResource Brush.TitleBarBackground}"
                Width="300"
                Margin="10"
                BorderThickness="1.5">

                <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="#272727"
                                Offset="0"/>

                            <GradientStop
                                Color="{StaticResource Color.TitleBarBackground}"
                                Offset="0.1"/>

                            <GradientStop
                                Color="{StaticResource Color.WindowBackground}"
                                Offset="0.9"/>

                            <GradientStop
                                Color="#151515"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                <StackPanel
                    Margin="15"
                    Spacing="10">

                    <TextBlock
                        Text="Selected sorting algorithm"
                        Foreground="#999"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Bubble sort"
                        FontSize="26"
                        Foreground="#AF4BE9"
                        FontWeight="Bold"/>

                    <Grid
                        ColumnDefinitions="*, *"
                        Height="300"
                        ColumnSpacing="10">

                        <controls:VerticalSlider
                            Title="Count"
                            Minimum="5"
                            Maximum="100"
                            Value="{Binding Count}"/>

                        <controls:VerticalSlider
                            Title="Operations"
                            Grid.Column="1"/>

                    </Grid>

                </StackPanel
>

            </Border>

            <Grid
    Grid.Column="1"
    Margin="15"
    RowDefinitions="*,Auto,Auto"
    RowSpacing="12">

    <controls:BarsRenderer
        Grid.Row="0"
        Bars="{Binding Bars}"
        SnapVersion="{Binding SnapVersion}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" />

    <Slider
        Grid.Row="1"
        Minimum="0"
        Maximum="{Binding TotalSteps}"
        Value="{Binding TimelinePosition, Mode=TwoWay}"
        IsEnabled="{Binding IsReady}" />

    <StackPanel
        Grid.Row="2"
        Orientation="Horizontal"
        Spacing="8">

        <TextBlock
            Text="Step:" />

        <TextBlock
            Text="{Binding CurrentStep}" />

        <TextBlock
            Text="/" />

        <TextBlock
            Text="{Binding TotalSteps}" />

    </StackPanel>

</Grid>

            <Border
                Grid.Column="2"
                CornerRadius="15"
                Background="{StaticResource Brush.TitleBarBackground}"
                Width="300"
                Margin="10">
                
            </Border
>

        </Grid>

        

    </Grid>

        <Border
    x:Name="ModalOverlay"
    Background="#55000000"
    CornerRadius="15"
    IsHitTestVisible="False">

    <Border.Transitions>
        <Transitions>
            <DoubleTransition
                Property="Opacity"
                Duration="0:0:0.25"
                Easing="CubicEaseOut" />
        </Transitions>
    </Border.Transitions>

    <Border
        x:Name="SettingsDialog"
        Width="800"
        Margin="50"
        Padding="24"
        CornerRadius="12"
        Background="#242424"
        HorizontalAlignment="Center"
        RenderTransformOrigin="50%,50%"
        BorderThickness="1.5">

        <Border.BorderBrush>

            <LinearGradientBrush
                StartPoint="50%, 0%"
                EndPoint="50%, 100%">

                <GradientStop Color="#2E2E2E"
                              Offset="0"/>

                <GradientStop Color="#262626"
                              Offset="0.2"/>

                <GradientStop Color="#262626"
                              Offset="0.8"/>

                <GradientStop Color="#1E1E1E"
                              Offset="1"/>

            </LinearGradientBrush
>

        </Border.BorderBrush>

        <Border.Transitions>
            <Transitions>
                <DoubleTransition
                    Property="Opacity"
                    Duration="0:0:0.25"
                    Easing="CubicEaseOut" />

                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.4">

                <TransformOperationsTransition.Easing>
        <components:EnchancedBackEaseOut
            Amplitude="0.4" />
    </TransformOperationsTransition.Easing>

            </TransformOperationsTransition>
            </Transitions>
        </Border.Transitions>

        <StackPanel Spacing="16">

            <TextBlock
                Text="Settings"
                FontSize="24"
                FontWeight="Bold" />

            <TextBlock Text="Animation speed" />

            <Slider
                Minimum="0"
                Maximum="100"
                Value="50" />

            <Button
                Content="Close"
                HorizontalAlignment="Right"
                Click="CloseSettings_Click" />

        </StackPanel>
    </Border>
</Border>

    </Grid>

</Window>
