<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaedit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:Sortacium.Presentation.Services"
    xmlns:vm="using:Sortacium.Presentation.ViewModels"
    xmlns:controls="using:Sortacium.Presentation.Controls"
    xmlns:components="using:Sortacium.Presentation.Components"
    xmlns:models="using:Sortacium.Presentation.Models"
    xmlns:views="using:Sortacium.Presentation.Views"
    x:Class="Sortacium.Presentation.Views.MainWindow"
    x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style
            Selector="Border#ModalOverlay">

            <Setter
                Property="Opacity"
                Value="0"/>

        </Style>

        <Style
            Selector="Border#ModalOverlay.open">

            <Setter
                Property="Opacity"
                Value="1"/>

        </Style>

        <Style
            Selector="controls|BeveledBorder#SettingsDialog">

            <Setter
                Property="Opacity"
                Value="0"/>

            <Setter
                Property="RenderTransform"
                Value="scale(0.9) translateY(-70px) translateX(70px)"/>

        </Style>

        <Style
            Selector="controls|BeveledBorder#SettingsDialog.open">

            <Setter
                Property="Opacity"
                Value="1"/>

            <Setter
                Property="RenderTransform"
                Value="scale(1) translateY(0px) translateX(0px)"/>

        </Style>

        <Style
            Selector="controls|BeveledBorder#AlgorithmSelectionDialog">

            <Setter
                Property="Opacity"
                Value="0"/>

            <Setter
                Property="RenderTransform"
                Value="scale(0.9) translateY(200px) translateX(-100px)"/>

        </Style>

        <Style
            Selector="controls|BeveledBorder#AlgorithmSelectionDialog.open">

            <Setter
                Property="Opacity"
                Value="1"/>

            <Setter
                Property="RenderTransform"
                Value="scale(1) translateY(0px) translateX(0px)"/>

        </Style>

        <!-- Default code line -->
        <Style
            Selector="Border.code-line">

            <Setter
                Property="Background"
                Value="{DynamicResource Palette.Brush.003D204D}"/>

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource Palette.Brush.00AF4BE9}"/>

        </Style>

        <!-- Active code line -->
        <Style
            Selector="Border.code-line.active">

            <Setter
                Property="Background"
                Value="{DynamicResource Palette.Brush.3D204D}"/>

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource Palette.Brush.AF4BE9}"/>

        </Style>

        <!-- Default code text -->
        <Style
            Selector="TextBlock.code-text">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Palette.Brush.CCCCCC}"/>
        </Style>

        <!-- Active code text -->
        <Style
            Selector="Border.code-line.active TextBlock.code-text">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Palette.Brush.C18DDF}"/>
        </Style>

    </Window.Styles>

    <Grid>

        <Grid
            Name="MainContent"
            RowDefinitions="auto,*">

            <Border Theme="{StaticResource Border.WindowTitleBar}">

                <Grid
                    ColumnDefinitions="*,auto,*">

                    <!-- Application title -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Sortacium"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Palette.Brush.AF4BE9}"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- Sorting controls -->
                    <StackPanel
                        Spacing="10"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        WindowDecorationProperties.ElementRole="User">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Shuffle}"
                            Command="{Binding ShuffleCommand}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Play}"
                            Command="{Binding PlayCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Pause}"
                            Command="{Binding PauseCommand}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Force}"
                            Command="{Binding ForceToEndCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Previous}"
                            Command="{Binding PreviousStepCommand}"
                            IsEnabled="{Binding IsReady}"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Next}"
                            Command="{Binding NextStepCommand}"
                            IsEnabled="{Binding IsReady}"/>

                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel
                        Spacing="10"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <controls:IconButton
                            Icon="{StaticResource Icon.Settings}"
                            WindowDecorationProperties.ElementRole="User"
                            Click="OpenSettings_Click"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Minimize}"
                            Click="Minimize_Click"
                            WindowDecorationProperties.ElementRole="MinimizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.Maximize}"
                            Click="Maximize_Click"
                            WindowDecorationProperties.ElementRole="MaximizeButton"/>

                        <controls:IconButton
                            Icon="{StaticResource Icon.PowerOff}"
                            Click="Close_Click"
                            WindowDecorationProperties.ElementRole="CloseButton"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid
                Margin="10"
                Grid.Row="1"
                ColumnDefinitions="auto, *, auto">

                <!-- Control panel -->
                <controls:BeveledBorder
                    Theme="{StaticResource BeveledBorder.Panel}"
                    Width="300">

                    <Grid
                        RowDefinitions="*, auto">

                        <StackPanel
                            Margin="15"
                            Spacing="10">

                            <TextBlock
                                Text="{DynamicResource L.SelectedAlgorithm}"
                                Foreground="{DynamicResource Palette.Brush.999999}"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding SelectedAlgorithm.Name}"
                                FontSize="24"
                                Foreground="{DynamicResource Palette.Brush.AF4BE9}"
                                FontWeight="Bold"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>

                            <Grid
                                ColumnDefinitions="*, *"
                                Height="300"
                                ColumnSpacing="10">

                                <controls:VerticalSlider
                                    Title="{DynamicResource L.Count}"
                                    Minimum="5"
                                    Maximum="100"
                                    Value="{Binding Count}"/>

                                <controls:VerticalSlider
                                    Title="{DynamicResource L.Speed}"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="{Binding Speed, Mode=TwoWay}"
                                    Suffix="{DynamicResource L.OpsPerSecond}"/>

                            </Grid>

                        </StackPanel>

                        <controls:IconButton
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Text="{DynamicResource L.SelectAlgorithm}"
                            Icon="{StaticResource Icon.Change}"
                            Foreground="{DynamicResource Palette.Brush.EEEEEE}"
                            Padding="20"
                            HorizontalContentAlignment="Center"
                            CornerRadius="10"
                            FontSize="14"
                            Click="OpenAlgorithmSelection_Click"/>

                    </Grid>

                </controls:BeveledBorder>

                <Grid
                    Grid.Column="1"
                    Margin="15"
                    RowDefinitions="*,Auto,Auto"
                    RowSpacing="12">

                    <controls:BarsRenderer
                        Grid.Row="0"
                        Bars="{Binding Bars}"
                        SnapVersion="{Binding SnapVersion}"
                        OperationsPerSecond="{Binding Speed}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                    <controls:HorizontalSlider
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="{Binding TotalSteps}"
                        Value="{Binding TimelinePosition, Mode=TwoWay}"
                        Title="{DynamicResource L.Step}"
                        Suffix="{Binding TotalSteps, StringFormat=' / {0}'}"
                        IsEnabled="{Binding IsReady}"/>

                </Grid>

                <controls:BeveledBorder
                    Grid.Column="2"
                    Width="420"
                    Theme="{StaticResource BeveledBorder.Panel}">

                    <Grid
                        RowDefinitions="Auto,*,Auto"
                        RowSpacing="12">

                        <!-- Header -->
                        <Grid
                            ColumnDefinitions="*,Auto">

                            <controls:StyledComboBox
                                Grid.Column="1"
                                MinWidth="145"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding AvailableLanguages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">

                                <controls:StyledComboBox.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:CodeLanguageOption">
                                        <TextBlock
                                            Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </controls:StyledComboBox.ItemTemplate>

                            </controls:StyledComboBox>

                        </Grid>

                        <!-- Code viewer -->
                        <Border
                            Grid.Row="1"
                            Theme="{StaticResource TextEditorContainer}">

                            <controls:SortingCodeEditor
                                x:Name="CodeEditor"
                                Language="{Binding SelectedLanguage.Id}"
                                Document="{Binding CodeDocument}"
                                HighlightedLines="{Binding HighlightedCodeLines}"
                                Background="Transparent"
                                Foreground="{DynamicResource Palette.Brush.CCCCCC}"
                                FontFamily="Consolas, Menlo, Monospace"
                                FontSize="14"
                                LineNumbersForeground="{DynamicResource Palette.Brush.666666}"/>

                        </Border>

                        <!-- Statistics -->
                        <StackPanel
                            Grid.Row="2"
                            Spacing="8">

                            <Border
                                Background="{DynamicResource Palette.Brush.303030}"
                                Height="1"/>

                            <TextBlock
                                Text="{DynamicResource L.ExecutionDetails}"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Palette.Brush.EEEEEE}"/>

                            <Grid
                                ColumnDefinitions="*,*">

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{DynamicResource L.Comparisons}" Foreground="{DynamicResource Palette.Brush.CCCCCC}"/>
                                    <TextBlock Text="{Binding ComparisonCount}" Foreground="{DynamicResource Palette.Brush.CCCCCC}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{DynamicResource L.Swaps}" Foreground="{DynamicResource Palette.Brush.CCCCCC}"/>
                                    <TextBlock Text="{Binding SwapCount}" Foreground="{DynamicResource Palette.Brush.CCCCCC}"/>
                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Text="{Binding VariablesDescription}"
                                Foreground="{DynamicResource Palette.Brush.AAAAAA}"
                                FontFamily="Consolas, Menlo, DejaVu Sans Mono"
                                FontSize="12"/>

                        </StackPanel>

                    </Grid>

                </controls:BeveledBorder>

            </Grid>

        </Grid>

        <Border
            x:Name="ModalOverlay"
            Background="{DynamicResource Palette.Brush.55000000}"
            CornerRadius="15"
            IsHitTestVisible="False">

            <Border.Transitions>

                <Transitions>

                    <DoubleTransition
                        Property="Opacity"
                        Duration="0:0:0.25"
                        Easing="CubicEaseOut"/>

                </Transitions>

            </Border.Transitions>

            <Grid Margin="50">

                <controls:BeveledBorder
                    x:Name="SettingsDialog"
                    Theme="{StaticResource BeveledBorder.DialogPanel}"
                    Margin="0, 0, 200, 0"
                    HorizontalAlignment="Right">

                    <views:SettingsView
                        CloseRequested="SettingsView_CloseRequested"/>

                </controls:BeveledBorder>

                <controls:BeveledBorder
                    x:Name="AlgorithmSelectionDialog"
                    Theme="{StaticResource BeveledBorder.DialogPanel}"
                    Margin="200, 0, 0, 0"
                    HorizontalAlignment="Left">

                    <views:LibraryView
                        DataContext="{Binding Library}"
                        CloseRequested="AlgorithmSelectionView_CloseRequested"
                        ApplyRequested="AlgorithmSelectionView_ApplyRequested"/>

                </controls:BeveledBorder>

            </Grid>

        </Border>

    </Grid>

</Window>
