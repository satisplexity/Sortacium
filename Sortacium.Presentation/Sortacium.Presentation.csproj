<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Sortacium.Presentation</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SoundFlow" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="NewFolder\" />
        <Content Include="Assets/Sounds/*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets\Sounds\pressed.wav" />
    <AvaloniaResource Remove="Assets\Sounds\released.wav" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove="P:\Sortacium\Sortacium.Presentation\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="P:\Sortacium\Sortacium.Presentation\.editorconfig" />
  </ItemGroup>
</Project>
