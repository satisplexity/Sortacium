<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:Sortacium.Presentation.Services"
    xmlns:components="using:Sortacium.Presentation.Components">

    <ControlTheme
        x:Key="ContentContainer"
        TargetType="{x:Type Border}">

        <Setter
            Property="CornerRadius"
            Value="15"/>

        <Setter
            Property="Background"
            Value="{DynamicResource Palette.Brush.222222}"/>

        <Setter
            Property="Padding"
            Value="15"/>

        <Setter
            Property="BorderThickness"
            Value="2, 3"/>

        <Setter
            Property="components:StrokeGradientAdapter.Enable"
            Value="True"/>

        <Setter
            Property="BorderBrush">

            <LinearGradientBrush
                StartPoint="50%, 0%"
                EndPoint="50%, 100%">

                <GradientStop
                    Color="{Binding Colors[2F2F2F], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="0"/>

                <GradientStop
                    Color="{Binding Colors[232323], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="0.1"/>

                <GradientStop
                    Color="{Binding Colors[232323], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="0.9"/>

                <GradientStop
                    Color="{Binding Colors[1F1F1F], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="1"/>

            </LinearGradientBrush>

        </Setter>

    </ControlTheme>

    <ControlTheme
        x:Key="TextEditorContainer"
        TargetType="{x:Type Border}">

        <Setter
            Property="CornerRadius"
            Value="12"/>

        <Setter
            Property="Background"
            Value="{DynamicResource Palette.Brush.191919}"/>

        <Setter
            Property="Padding"
            Value="15"/>

        <Setter
            Property="BorderThickness"
            Value="1, 3"/>

        <Setter
            Property="components:StrokeGradientAdapter.Enable"
            Value="True"/>

        <Setter
            Property="BorderBrush">

            <LinearGradientBrush
                StartPoint="50%, 0%"
                EndPoint="50%, 100%">

                <GradientStop
                    Color="{Binding Colors[151515], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="0"/>

                <GradientStop
                    Color="{Binding Colors[1A1A1A], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="0.1"/>

                <GradientStop
                    Color="{Binding Colors[1A1A1A], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="0.9"/>

                <GradientStop
                    Color="{Binding Colors[2F2F2F], Source={x:Static appearance:AppearanceService.Instance}}"
                    Offset="1"/>

            </LinearGradientBrush>

        </Setter>

    </ControlTheme>

</ResourceDictionary>
