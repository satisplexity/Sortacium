                "pseudocode": {
                    "lines": [
                        "PROCEDURE QuickSort(A, low, high)",
                        "    IF low >= high THEN RETURN",
                        "    pivot = A[high]",
                        "    i = low",
                        "    FOR j FROM low TO high - 1",
                        "        IF A[j] < pivot",
                        "            SWAP A[i], A[j]",
                        "            i = i + 1",
                        "    SWAP A[i], A[high]",
                        "    QuickSort(A, low, i - 1)",
                        "    QuickSort(A, i + 1, high)"
