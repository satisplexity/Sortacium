                "csharp": {
                    "lines": [
                        "public static void MergeSort(double[] a, int left, int right)",
                        "{",
                        "    if (left >= right) return;",
                        "    int mid = left + (right - left) / 2;",
                        "    MergeSort(a, left, mid);",
                        "    MergeSort(a, mid + 1, right);",
                        "    Merge(a, left, mid, right);",
                        "}",
                        "",
                        "private static void Merge(double[] a, int left, int mid, int right)",
                        "{",
                        "    double[] l = a[left..(mid + 1)];",
                        "    double[] r = a[(mid + 1)..(right + 1)];",
                        "    var result = new List<double>();",
                        "    int i = 0, j = 0;",
                        "    while (i < l.Length && j < r.Length)",
                        "    {",
                        "        if (l[i] <= r[j])",
                        "            result.Add(l[i++]);",
                        "        else",
                        "            result.Add(r[j++]);",
                        "    }",
                        "    while (i < l.Length) result.Add(l[i++]);",
                        "    while (j < r.Length) result.Add(r[j++]);",
                        "    for (int k = 0; k < result.Count; k++)",
                        "    {",
                        "        int target = left + k;",
                        "        int source = Array.IndexOf(a, result[k], target, right - target + 1);",
                        "        if (target != source)",
                        "            (a[target], a[source]) = (a[source], a[target]);",
                        "    }",
                        "}"
