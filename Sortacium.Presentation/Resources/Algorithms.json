                        "",
                        "void bubble_sort(double *a, size_t n)",
                        "{",
                        "    for (size_t i = 0; i + 1 < n; ++i)",
                        "    {",
                        "        for (size_t j = 0; j + i + 1 < n; ++j)",
                        "        {",
                        "            if (a[j] > a[j + 1])",
                        "            {",
                        "                double temp = a[j];",
                        "                a[j] = a[j + 1];",
                        "                a[j + 1] = temp;",
                        "            }",
