                        "public static void QuickSort(double[] a, int low, int high)",
                        "{",
                        "    if (low >= high) return;",
                        "    double pivot = a[high];",
                        "    int i = low;",
                        "    for (int j = low; j < high; j++)",
                        "    {",
                        "        if (a[j] < pivot)",
                        "        {",
                        "            (a[i], a[j]) = (a[j], a[i]);",
                        "            i++;",
                        "        }",
                        "    }",
                        "    (a[i], a[high]) = (a[high], a[i]);",
                        "    QuickSort(a, low, i - 1);",
