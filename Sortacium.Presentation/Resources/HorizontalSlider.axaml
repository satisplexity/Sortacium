<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:Sortacium.Presentation.Services"
    xmlns:controls="using:Sortacium.Presentation.Controls">

    <!-- Track segments -->
    <ControlTheme
        x:Key="SliderSegmentTheme"
        TargetType="RepeatButton">
        <Setter
            Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Thumb -->
    <ControlTheme
        x:Key="SliderThumbTheme"
        TargetType="Thumb">
        <Setter
            Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Slider -->
    <ControlTheme
        x:Key="{x:Type controls:HorizontalSlider}"
        TargetType="controls:HorizontalSlider">

        <Setter
            Property="Foreground"
            Value="White"/>

        <Setter
            Property="Margin"
            Value="5"/>

        <Setter
            Property="Template">
            <ControlTemplate>

                <!-- Outer Border -->
                <Border
                    Background="{DynamicResource Palette.Brush.292929}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="4">

                    <Border.BorderBrush>

                        <LinearGradientBrush
                            StartPoint="50%, 0%"
                            EndPoint="50%, 100%">

                            <GradientStop
                                Color="{Binding Colors[414141], Source={x:Static appearance:AppearanceService.Instance}}"
                                Offset="0"/>

                            <GradientStop
                                Color="{Binding Colors[292929], Source={x:Static appearance:AppearanceService.Instance}}"
                                Offset="0.2"/>

                            <GradientStop
                                Color="{Binding Colors[292929], Source={x:Static appearance:AppearanceService.Instance}}"
                                Offset="0.8"/>

                            <GradientStop
                                Color="{Binding Colors[232323], Source={x:Static appearance:AppearanceService.Instance}}"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Border.BorderBrush>

                    <!-- Inner Border -->
                    <Border
                        Background="{DynamicResource Palette.Brush.232323}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        ClipToBounds="True">

                        <Border.BorderBrush>

                            <LinearGradientBrush
                                StartPoint="50%, 0%"
                                EndPoint="50%, 100%">

                                <GradientStop
                                    Color="{Binding Colors[1C1C1C], Source={x:Static appearance:AppearanceService.Instance}}"
                                    Offset="0"/>

                                <GradientStop
                                    Color="{Binding Colors[232323], Source={x:Static appearance:AppearanceService.Instance}}"
                                    Offset="0.2"/>

                                <GradientStop
                                    Color="{Binding Colors[232323], Source={x:Static appearance:AppearanceService.Instance}}"
                                    Offset="0.8"/>

                                <GradientStop
                                    Color="{Binding Colors[2B2B2B], Source={x:Static appearance:AppearanceService.Instance}}"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.BorderBrush>

                        <Grid
                            ColumnDefinitions="Auto,*,auto">

                            <!-- Track -->
                            <Track
                                Name="PART_Track"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value, Mode=TwoWay}"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}">

                                <Track.DecreaseButton>
                                    <RepeatButton
                                        Name="PART_DecreaseButton"
                                        Theme="{StaticResource SliderSegmentTheme}"
                                        Focusable="False">
                                        <RepeatButton.Background>
                                            <LinearGradientBrush
                                                StartPoint="0%,50%"
                                                EndPoint="100%,50%">

                                                <GradientStop
                                                    Color="{Binding Colors[373737], Source={x:Static appearance:AppearanceService.Instance}}"
                                                    Offset="0"/>

                                                <GradientStop
                                                    Color="{Binding Colors[8025A6], Source={x:Static appearance:AppearanceService.Instance}}"
                                                    Offset="1"/>

                                            </LinearGradientBrush>
                                        </RepeatButton.Background>
                                    </RepeatButton>
                                </Track.DecreaseButton>

                                <Track.IncreaseButton>
                                    <RepeatButton
                                        Name="PART_IncreaseButton"
                                        Theme="{StaticResource SliderSegmentTheme}"
                                        Background="{DynamicResource Palette.Brush.202020}"
                                        Focusable="False"/>
                                </Track.IncreaseButton>

                                <Track.Thumb>
                                    <Thumb
                                        Name="PART_Thumb"
                                        Theme="{StaticResource SliderThumbTheme}"
                                        Background="{DynamicResource Palette.Brush.8734AC}"
                                        BorderBrush="{DynamicResource Palette.Brush.A34BC4}"
                                        Width="16"/>
                                </Track.Thumb>

                            </Track>

                            <!-- Title -->
                            <TextBlock
                                Grid.Column="0"
                                Text="{TemplateBinding Title}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="16"
                                Margin="5"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>

                            <!-- Value -->
                            <Border
                                Grid.Column="2"
                                Background="{DynamicResource Palette.Brush.393939}"
                                BorderBrush="{DynamicResource Palette.Brush.1E1E1E}"
                                BorderThickness="1,0,0,0">

                                <TextBlock
                                    Text="{Binding Value,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           StringFormat='{}{0:F0}'}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                        </Grid>

                    </Border>

                </Border>

            </ControlTemplate>
        </Setter>

        <!-- Hover -->
        <Style
            Selector="^:pointerover /template/ Thumb">
            <Setter
                Property="Background"
                Value="{DynamicResource Palette.Brush.9945BE}"/>
        </Style>

        <!-- Disabled -->
        <Style
            Selector="^:disabled">
            <Setter
                Property="Opacity"
                Value="0.45"/>
        </Style>

    </ControlTheme>

</ResourceDictionary>
